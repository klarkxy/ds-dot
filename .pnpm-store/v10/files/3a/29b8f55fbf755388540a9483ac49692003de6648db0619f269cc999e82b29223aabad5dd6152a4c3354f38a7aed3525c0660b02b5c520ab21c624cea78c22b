{"version":3,"file":"core2.js","names":[],"sources":["../src/core/formula.js","../src/core/views.js"],"sourcesContent":["// Adapted from deep-view/src/core/formula.js (deep-view 0.1.0, Apache-2.0).\n// Kept as the same bounded expression interpreter: no eval, property access,\n// assignment or loops. The DSH migration preserves its grammar and error model.\n// It reads names and calls a fixed set of functions without reaching the page.\n\nconst FUNCTIONS = {\n  min: { args: [1, Infinity], run: (...values) => Math.min(...values.map(num)) },\n  max: { args: [1, Infinity], run: (...values) => Math.max(...values.map(num)) },\n  abs: { args: [1, 1], run: value => Math.abs(num(value)) },\n  floor: { args: [1, 1], run: value => Math.floor(num(value)) },\n  ceil: { args: [1, 1], run: value => Math.ceil(num(value)) },\n  sqrt: { args: [1, 1], run: value => Math.sqrt(num(value)) },\n  pow: { args: [2, 2], run: (base, power) => num(base) ** num(power) },\n  round: { args: [1, 2], run: (value, digits = 0) => roundTo(num(value), digitsOf(digits)) },\n  clamp: { args: [3, 3], run: (value, low, high) => Math.min(Math.max(num(value), num(low)), num(high)) },\n  fixed: { args: [1, 2], run: (value, digits = 0) => roundTo(num(value), digitsOf(digits)).toFixed(digitsOf(digits)) },\n  format: { args: [1, 2], run: (value, digits = 0) => grouped(num(value), digitsOf(digits)) },\n  percent: { args: [1, 2], run: (value, digits = 0) => `${grouped(num(value) * 100, digitsOf(digits))}%` },\n  count: { args: [1, 1], run: value => Array.isArray(value) ? value.length : value !== null && typeof value === 'object' ? Object.keys(value).length : value == null || value === '' ? 0 : 1 },\n  sum: { args: [1, 1], run: value => numbers(value).reduce((sum, current) => sum + current, 0) },\n  mean: { args: [1, 1], run: value => { const values = numbers(value); if (!values.length) return 0; return values.reduce((sum, current) => sum + current, 0) / values.length } },\n  join: { args: [1, 2], run: (value, separator = ', ') => Array.isArray(value) ? value.map(String).join(String(separator)) : String(value ?? '') },\n  contains: { args: [2, 2], run: (values, expected) => Array.isArray(values) && values.some(value => value === expected) },\n  sin: { args: [1, 1], run: value => Math.sin(num(value)) },\n  cos: { args: [1, 1], run: value => Math.cos(num(value)) },\n  tan: { args: [1, 1], run: value => Math.tan(num(value)) },\n  exp: { args: [1, 1], run: value => Math.exp(num(value)) },\n  ln: { args: [1, 1], run: value => Math.log(num(value)) },\n  log: { args: [1, 1], run: value => Math.log10(num(value)) },\n}\nfunction numbers(value) {\n  if (!Array.isArray(value)) fail('expected a list of numbers')\n  if (value.length > 1000) fail('list exceeds the limit of 1000')\n  return value.map(num)\n}\nexport const FORMULA_FUNCTIONS = Object.keys(FUNCTIONS)\nconst CONSTANTS = new Map([['true', true], ['false', false]])\n// Nesting deeper than this is no calculation a view needs; the parser recurses per level.\nconst MAX_NESTING = 64\n\nclass FormulaError extends Error {}\nconst fail = (message) => { throw new FormulaError(message) }\n\nfunction num(value) {\n  if (typeof value === 'number') return value\n  if (typeof value === 'boolean') return value ? 1 : 0\n  const parsed = Number(value)\n  if (typeof value === 'string' && value.trim() !== '' && !Number.isNaN(parsed)) return parsed\n  return fail(`${JSON.stringify(value)} is not a number`)\n}\nconst digitsOf = (digits) => {\n  const value = num(digits)\n  if (!Number.isInteger(value) || value < 0 || value > 10) fail('digits must be a whole number from 0 to 10')\n  return value\n}\nconst roundTo = (value, digits) => {\n  const scale = 10 ** digits\n  return Math.round(value * scale) / scale\n}\nfunction grouped(value, digits) {\n  if (!Number.isFinite(value)) return String(value)\n  const [whole, part] = Math.abs(roundTo(value, digits)).toFixed(digits).split('.')\n  const sign = value < 0 && Number(whole + (part ?? '')) !== 0 ? '-' : ''\n  return `${sign}${whole.replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',')}${part ? `.${part}` : ''}`\n}\n\n// -------------------------------------------------------------------------\n// Tokens and parsing\n\nconst IDENT = /^[A-Za-z_][A-Za-z0-9_]*$/\nexport const isName = value => typeof value === 'string' && IDENT.test(value)\nconst OPERATORS = ['==', '!=', '<=', '>=', '&&', '||', '+', '-', '*', '/', '%', '<', '>', '!', '?', ':', '(', ')', ',']\n\nfunction tokenize(source) {\n  const tokens = []\n  let at = 0\n  while (at < source.length) {\n    const char = source[at]\n    if (/\\s/.test(char)) { at += 1; continue }\n    const number = /^(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?/.exec(source.slice(at))\n    if (number) { tokens.push({ kind: 'number', value: Number(number[0]), at }); at += number[0].length; continue }\n    const name = /^[A-Za-z_][A-Za-z0-9_]*/.exec(source.slice(at))\n    if (name) { tokens.push({ kind: 'name', value: name[0], at }); at += name[0].length; continue }\n    if (char === '\"' || char === '\\'') {\n      let end = at + 1\n      let text = ''\n      while (end < source.length && source[end] !== char) {\n        if (source[end] === '\\\\' && end + 1 < source.length) { text += source[end + 1]; end += 2; continue }\n        text += source[end]\n        end += 1\n      }\n      if (end >= source.length) fail(`unclosed string at ${at + 1}`)\n      tokens.push({ kind: 'string', value: text, at })\n      at = end + 1\n      continue\n    }\n    const operator = OPERATORS.find(op => source.startsWith(op, at))\n    if (operator === undefined) fail(`unexpected ${JSON.stringify(char)} at ${at + 1}`)\n    tokens.push({ kind: 'op', value: operator, at })\n    at += operator.length\n  }\n  return tokens\n}\n\nconst BINARY = [['||'], ['&&'], ['==', '!='], ['<', '<=', '>', '>='], ['+', '-'], ['*', '/', '%']]\n\nfunction parse(source) {\n  const tokens = tokenize(source)\n  let index = 0\n  let depth = 0\n  const peek = () => tokens[index]\n  const isOp = value => peek()?.kind === 'op' && peek().value === value\n  const expect = (value) => {\n    if (!isOp(value)) fail(peek() ? `expected \"${value}\" at ${peek().at + 1}` : `expected \"${value}\" at the end`)\n    index += 1\n  }\n  const nest = (read) => {\n    depth += 1\n    if (depth > MAX_NESTING) fail(`nested more than ${MAX_NESTING} levels`)\n    const node = read()\n    depth -= 1\n    return node\n  }\n  const ternary = () => nest(() => {\n    const test = binary(0)\n    if (!isOp('?')) return test\n    index += 1\n    const yes = ternary()\n    expect(':')\n    return { type: 'if', test, yes, no: ternary() }\n  })\n  const binary = (level) => {\n    if (level === BINARY.length) return unary()\n    let left = binary(level + 1)\n    while (peek()?.kind === 'op' && BINARY[level].includes(peek().value)) {\n      const op = peek().value\n      index += 1\n      left = { type: 'binary', op, left, right: binary(level + 1) }\n    }\n    return left\n  }\n  const unary = () => {\n    if (isOp('-') || isOp('!') || isOp('+')) {\n      const op = peek().value\n      index += 1\n      return nest(() => ({ type: 'unary', op, value: unary() }))\n    }\n    return primary()\n  }\n  const primary = () => {\n    const token = peek()\n    if (token === undefined) fail('the formula ends too early')\n    index += 1\n    if (token.kind === 'number' || token.kind === 'string') return { type: 'value', value: token.value }\n    if (token.kind === 'op' && token.value === '(') {\n      const inner = ternary()\n      expect(')')\n      return inner\n    }\n    if (token.kind !== 'name') fail(`unexpected \"${token.value}\" at ${token.at + 1}`)\n    if (!isOp('(')) return CONSTANTS.has(token.value) ? { type: 'value', value: CONSTANTS.get(token.value) } : { type: 'name', name: token.value }\n    const fn = Object.hasOwn(FUNCTIONS, token.value) ? FUNCTIONS[token.value] : undefined\n    if (fn === undefined) fail(`unknown function \"${token.value}\"; allowed: ${FORMULA_FUNCTIONS.join(', ')}`)\n    index += 1\n    const args = []\n    if (!isOp(')')) {\n      args.push(ternary())\n      while (isOp(',')) { index += 1; args.push(ternary()) }\n    }\n    expect(')')\n    if (args.length < fn.args[0] || args.length > fn.args[1]) {\n      fail(`${token.value}() takes ${fn.args[0] === fn.args[1] ? fn.args[0] : fn.args[1] === Infinity ? `at least ${fn.args[0]}` : `${fn.args[0]} or ${fn.args[1]}`} argument${fn.args[1] === 1 ? '' : 's'}; got ${args.length}`)\n    }\n    return { type: 'call', name: token.value, args }\n  }\n  if (tokens.length === 0) fail('the formula is empty')\n  const tree = ternary()\n  if (index < tokens.length) fail(`unexpected \"${peek().value}\" at ${peek().at + 1}`)\n  return tree\n}\n\nfunction namesIn(node, found = new Set()) {\n  if (node.type === 'name') found.add(node.name)\n  else if (node.type === 'unary') namesIn(node.value, found)\n  else if (node.type === 'binary') { namesIn(node.left, found); namesIn(node.right, found) }\n  else if (node.type === 'if') { namesIn(node.test, found); namesIn(node.yes, found); namesIn(node.no, found) }\n  else if (node.type === 'call') for (const arg of node.args) namesIn(arg, found)\n  return found\n}\n\n// { tree, names } or { error }. `names` are the names the formula reads.\nexport function compileFormula(source) {\n  if (typeof source !== 'string') return { error: 'expected a formula string' }\n  try {\n    const tree = parse(source)\n    return { tree, names: [...namesIn(tree)] }\n  } catch (error) {\n    if (error instanceof FormulaError) return { error: error.message }\n    throw error\n  }\n}\n\n// -------------------------------------------------------------------------\n// Evaluation. `lookup(name)` returns a name's value or throws.\n\nfunction run(node, lookup) {\n  switch (node.type) {\n    case 'value': return node.value\n    case 'name': return lookup(node.name)\n    case 'unary': {\n      const value = run(node.value, lookup)\n      if (node.op === '!') return !truthy(value)\n      return node.op === '-' ? -num(value) : num(value)\n    }\n    case 'if': return truthy(run(node.test, lookup)) ? run(node.yes, lookup) : run(node.no, lookup)\n    case 'call': return FUNCTIONS[node.name].run(...node.args.map(arg => run(arg, lookup)))\n    default: return binary(node, lookup)\n  }\n}\nconst truthy = value => (typeof value === 'string' ? value !== '' : Boolean(value))\n\nfunction binary(node, lookup) {\n  if (node.op === '&&') return truthy(run(node.left, lookup)) ? run(node.right, lookup) : false\n  if (node.op === '||') { const left = run(node.left, lookup); return truthy(left) ? left : run(node.right, lookup) }\n  const left = run(node.left, lookup)\n  const right = run(node.right, lookup)\n  switch (node.op) {\n    case '+': return typeof left === 'string' || typeof right === 'string' ? `${show(left)}${show(right)}` : num(left) + num(right)\n    case '-': return num(left) - num(right)\n    case '*': return num(left) * num(right)\n    case '/': return num(left) / num(right)\n    case '%': return num(left) % num(right)\n    case '==': return left === right\n    case '!=': return left !== right\n    case '<': return num(left) < num(right)\n    case '<=': return num(left) <= num(right)\n    case '>': return num(left) > num(right)\n    default: return num(left) >= num(right)\n  }\n}\n\n// A value as text: numbers lose float noise (0.1 + 0.2 shows 0.3).\nexport function show(value) {\n  if (typeof value === 'number') return Number.isFinite(value) ? String(Number(value.toPrecision(12))) : String(value)\n  return String(value)\n}\n\n// A scope for one view: input values, plus `let` names worked out on demand. A cycle\n// or a missing name fails the formula that reads it.\nexport function createScope(inputs, lets) {\n  const done = new Map()\n  const busy = new Set()\n  const lookup = (name) => {\n    if (inputs.has(name)) return inputs.get(name)\n    if (done.has(name)) return done.get(name)\n    const tree = lets.get(name)\n    if (tree === undefined) fail(`unknown name \"${name}\"`)\n    if (busy.has(name)) fail(`\"${name}\" refers to itself`)\n    busy.add(name)\n    try {\n      const value = run(tree, lookup)\n      done.set(name, value)\n      return value\n    } finally { busy.delete(name) }\n  }\n  return lookup\n}\n\n// { value } or { error }.\nexport function evaluate(tree, lookup) {\n  try {\n    return { value: run(tree, lookup) }\n  } catch (error) {\n    if (error instanceof FormulaError) return { error: error.message }\n    if (error instanceof RangeError) return { error: 'the formula is too deep to work out' }\n    throw error\n  }\n}\n","// Adapted from deep-view/src/core/views.js (deep-view 0.1.0, Apache-2.0).\n// DSH migration: html is deliberately rejected rather than migrating its frame;\n// validation, formulas and answers retain the original bounded JSON semantics.\n// Pure validation and evaluation of a declarative card, on Host and Client.\n// Formulas use formula.js; model-authored code never enters the DOM.\n\nimport { compileFormula, createScope, evaluate, isName, show } from './formula.js'\n\nconst LAYOUT = ['stack', 'row']\nconst DISPLAY = ['text', 'metric', 'table', 'chart', 'progress', 'callout', 'sources', 'steps']\nconst INPUT_TYPES = ['slider', 'choice', 'toggle', 'number', 'math', 'flow', 'explore', 'map']\nconst ANSWERS = ['options', 'confirm', 'form', 'submit']\nconst COMPONENTS = [...LAYOUT, ...DISPLAY, ...INPUT_TYPES, ...ANSWERS]\nconst TONES = ['good', 'warn', 'bad']\nconst TEXT_TONES = ['muted']\nconst CALLOUT_TONES = ['info', 'good', 'warn', 'bad']\nexport const CHART_KINDS = ['bar', 'hbar', 'line', 'area', 'donut']\nconst INTERACTIVE = new Set(ANSWERS)\nconst INPUTS = new Set(INPUT_TYPES)\nconst PROPS = {\n  stack: ['id', 'children', 'let'],\n  row: ['id', 'children', 'let'],\n  text: ['id', 'text', 'tone'],\n  metric: ['id', 'label', 'value', 'tone', 'caption'],\n  table: ['id', 'columns', 'rows'],\n  chart: ['id', 'kind', 'categories', 'series', 'unit', 'caption'],\n  progress: ['id', 'label', 'percent', 'value', 'max', 'valueLabel', 'tone'],\n  callout: ['id', 'text', 'tone'],\n  sources: ['id', 'items'],\n  steps: ['id', 'items'],\n  slider: ['id', 'label', 'min', 'max', 'step', 'value', 'unit'],\n  choice: ['id', 'label', 'options', 'value'],\n  toggle: ['id', 'label', 'value'],\n  number: ['id', 'label', 'min', 'max', 'step', 'value', 'unit'],\n  math: ['id', 'mathPoints', 'curves', 'domain', 'range', 'caption'],\n  flow: ['id', 'nodes', 'edges', 'caption'],\n  explore: ['id', 'data', 'xKey', 'yKey', 'colorKey', 'select', 'caption'],\n  map: ['id', 'center', 'zoom', 'locations', 'routes', 'caption'],\n  options: ['id', 'options', 'multi'],\n  confirm: ['id', 'confirmLabel', 'cancelLabel'],\n  form: ['id', 'fields', 'submitLabel', 'cancelLabel'],\n  submit: ['id', 'label'],\n}\nconst FIELD_PROPS = ['id', 'label', 'placeholder', 'value', 'multiline', 'readOnly']\nconst STEP_STATUSES = ['done', 'active', 'pending', 'blocked']\nconst MAX_DEPTH = 8\nconst MAX_NODES = 64\nconst MAX_CHILDREN = 16\nconst MAX_TEXT = 2000\nconst MAX_CELL = 200\nconst MAX_COLUMNS = 8\nconst MAX_ROWS = 50\nconst MAX_OPTIONS = 8\nconst MAX_FIELDS = 6\nconst MAX_STEPS = 8\nconst SUMMARY_PART = 40\nconst SUMMARY_COUNT = 8\nconst RESERVED = new Set(['true', 'false'])\n// UTF-8 bytes of the blueprint JSON plus the title. Not a wrapped document:\n// the tool rejects a show_view whose viewBytes() is over this before it\n// normalizes or validates, so the number has to be the bytes the model sent.\nexport const VIEW_BYTE_LIMIT = 8192\n\nconst isRecord = value => value !== null && typeof value === 'object' && !Array.isArray(value)\nconst quoted = value => JSON.stringify(value)\nconst allowed = list => list.join(', ')\nconst isNumber = value => typeof value === 'number' && Number.isFinite(value)\nconst isScalar = value => typeof value === 'string' || typeof value === 'boolean' || isNumber(value)\n\n// `{ \"=\": \"a * b\" }`: a value worked out from the view's inputs.\nexport const isFormula = value => isRecord(value) && Object.keys(value).length === 1 && Object.hasOwn(value, '=')\n\nexport function viewBytes(title, view) {\n  return new TextEncoder().encode(`${JSON.stringify(view) ?? ''}${title ?? ''}`).length\n}\n\nconst NUMERIC = ['value', 'percent', 'min', 'max', 'step', 'height']\nconst numeric = value => (typeof value === 'string' && value.trim() !== '' && !Number.isNaN(Number(value)) ? Number(value) : value)\n\n// Some providers serialize nested arrays as `{ item: [...] }` (XML-style) and\n// numbers as strings. Normalize the blueprint before validation so a model is\n// not asked to retry a call whose only fault is the provider's encoding.\n// Arrays are unwrapped; numeric fields and chart values accept a numeric string.\n// A form field's `value` is the text the user starts with, so `value` inside a\n// `fields` array keeps its type: \"42\" must stay text, not become a number.\n// Returns a new object; the input is not mutated.\nexport function normalizeView(value, inFormFields = false) {\n  if (Array.isArray(value)) return value.map(item => normalizeView(item, inFormFields))\n  if (!isRecord(value)) return value\n  const keys = Object.keys(value)\n  // Unwrap recursively: a provider may nest the wrapper, as { item: { item: [...] } }.\n  if (keys.length === 1 && keys[0] === 'item') {\n    const inner = normalizeView(value.item, inFormFields)\n    if (Array.isArray(inner)) return inner\n  }\n  // Define own properties: an incoming \"__proto__\" key must become data the\n  // validator can reject, not hit the prototype setter and vanish from the JSON.\n  const out = {}\n  for (const key of keys) Object.defineProperty(out, key, { value: normalizeView(value[key], inFormFields || key === 'fields'), writable: true, enumerable: true, configurable: true })\n  for (const field of NUMERIC) if ((field !== 'value' || !inFormFields) && Object.hasOwn(out, field)) out[field] = numeric(out[field])\n  if (Array.isArray(out.values)) out.values = out.values.map(numeric)\n  return out\n}\n\nexport function validateView(view) {\n  const ctx = { ids: new Set(), nodes: 0, interactive: false, inputs: new Map(), lets: new Map(), formulas: [] }\n  const error = checkNode(view, 'view', 1, ctx) ?? checkFormulas(ctx)\n  return error === undefined ? { ok: true, interactive: ctx.interactive } : { ok: false, error }\n}\n\n// What show_view checks before it shows a view: the same answer on the host and\n// in the client. The bytes are measured as sent, before normalizeView unwraps the\n// provider's encoding, or a wrapped view could shrink under the byte limit. The\n// normalized view and the trimmed title come back; the title may be empty.\nexport function checkShownView(title, sent) {\n  let bytes\n  try { bytes = viewBytes(title, sent) } catch { return { error: 'The view is not JSON data.' } }\n  if (bytes > VIEW_BYTE_LIMIT) return { error: `The view is ${bytes} bytes; the limit is ${VIEW_BYTE_LIMIT}.` }\n  if (title !== undefined && title !== null && typeof title !== 'string') return { error: 'title: expected a string' }\n  const named = String(title ?? '').trim()\n  const view = normalizeView(sent)\n  const checked = validateView(view)\n  if (!checked.ok) return { error: checked.error }\n  return { title: named, view, interactive: checked.interactive }\n}\n\nfunction checkNode(node, path, depth, ctx) {\n  if (!isRecord(node)) return `${path}: expected a component object`\n  if (depth > MAX_DEPTH) return `${path}: ${depth} levels exceeds the limit of ${MAX_DEPTH}`\n  ctx.nodes += 1\n  if (ctx.nodes > MAX_NODES) return `${path}: ${ctx.nodes} components exceeds the limit of ${MAX_NODES}`\n  const type = node.type\n  if (!COMPONENTS.includes(type)) return `${path}.type: unknown component ${quoted(type)}; allowed: ${allowed(COMPONENTS)}`\n  if (node.id !== undefined && !INPUTS.has(type) && !INTERACTIVE.has(type)) {\n    const idError = checkId(node, path, ctx)\n    if (idError !== undefined) return idError\n  }\n  const props = PROPS[type]\n  for (const key of Object.keys(node)) {\n    if (key === 'type' || props.includes(key)) continue\n    return `${path}.${key}: unknown property ${quoted(key)}; allowed: ${allowed(props)}`\n  }\n  if (INTERACTIVE.has(type)) ctx.interactive = true\n  switch (type) {\n    case 'stack': case 'row': return checkLayout(node, path, depth, ctx)\n    case 'text': return checkText(node, path, ctx)\n    case 'metric': return checkMetric(node, path, ctx)\n    case 'table': return checkTable(node, path, ctx)\n    case 'chart': return checkChart(node, path, ctx)\n    case 'progress': return checkProgress(node, path, ctx)\n    case 'callout': return checkCallout(node, path, ctx)\n    case 'sources': return checkSources(node, path)\n    case 'steps': return checkSteps(node, path, ctx)\n    case 'slider': case 'number': return checkNumberInput(node, path, ctx)\n    case 'choice': return checkChoice(node, path, ctx)\n    case 'toggle': return checkToggle(node, path, ctx)\n    case 'math': case 'flow': case 'explore': case 'map': return checkRichNode(node, path, ctx)\n    case 'options': return checkOptions(node, path, ctx)\n    case 'confirm': return checkConfirm(node, path, ctx)\n    case 'form': return checkForm(node, path, ctx)\n    default: return checkSubmit(node, path, ctx)\n  }\n}\n\nfunction checkLayout(node, path, depth, ctx) {\n  if (node.let !== undefined) {\n    if (depth !== 1) return `${path}.let: only the outermost component can define names`\n    if (!isRecord(node.let)) return `${path}.let: expected an object of names to formulas`\n    for (const [name, source] of Object.entries(node.let)) {\n      if (!isName(name) || RESERVED.has(name)) return `${path}.let.${name}: a name is letters, digits and _, and starts with a letter or _`\n      if (typeof source !== 'string') return `${path}.let.${name}: expected a formula string`\n      ctx.lets.set(name, { source, path: `${path}.let.${name}` })\n    }\n  }\n  if (!Array.isArray(node.children)) return `${path}.children: expected an array of 1 to ${MAX_CHILDREN} components`\n  if (node.children.length < 1 || node.children.length > MAX_CHILDREN) return `${path}.children: expected 1 to ${MAX_CHILDREN} children; got ${node.children.length}`\n  for (let index = 0; index < node.children.length; index += 1) {\n    const error = checkNode(node.children[index], `${path}.children[${index}]`, depth + 1, ctx)\n    if (error !== undefined) return error\n  }\n  return undefined\n}\n\n// A property that may be a literal of `kind` or a formula giving one. Formulas are\n// checked once the whole tree, with every input and name, is known.\nfunction checkValue(node, key, path, ctx, kind, { required = false, max = MAX_TEXT } = {}) {\n  const value = node[key]\n  const at = `${path}.${key}`\n  if (value === undefined) return required ? `${at}: ${expected(kind)}` : undefined\n  if (isFormula(value)) {\n    ctx.formulas.push({ source: value['='], path: at, kind })\n    return undefined\n  }\n  if (kind === 'number') return isNumber(value) ? undefined : `${at}: ${expected(kind)}`\n  if (Array.isArray(kind)) return kind.includes(value) ? undefined : `${at}: unknown tone ${quoted(value)}; allowed: ${allowed(kind)}`\n  if (kind === 'string') {\n    if (typeof value !== 'string') return `${at}: ${expected(kind)}`\n    return value.length > max ? `${at}: ${value.length} characters exceeds the limit of ${max}` : undefined\n  }\n  if (!isScalar(value)) return `${at}: ${expected(kind)}`\n  return undefined\n}\nconst expected = kind => (kind === 'number' ? 'expected a number' : kind === 'string' ? 'expected a string' : Array.isArray(kind) ? `expected one of ${allowed(kind)}` : 'expected a string or a number')\n\nfunction checkText(node, path, ctx) {\n  return checkValue(node, 'text', path, ctx, 'string', { required: true })\n    ?? checkValue(node, 'tone', path, ctx, TEXT_TONES)\n}\n\nfunction checkMetric(node, path, ctx) {\n  if (typeof node.label !== 'string') return `${path}.la