-click to clear', exploreIntervalHint: 'Drag to select a range; double-click to clear',\n  exploreFailed: 'The chart could not be drawn.', dataRows: 'Data: {n} rows', dataTruncated: 'Showing {shown} of {n} rows',\n  map: 'Map', mapMarker: 'Map marker', zoomIn: 'Zoom in', zoomOut: 'Zoom out', resetBearing: 'Reset bearing to north',\n  mapUnavailable: 'Map is unavailable in this environment.', mapFailed: 'Map failed to load.', mapFallback: 'You can still pick a location below.', locations: 'Locations',\n}\n","import { useMemo, useSyncExternalStore } from 'react'\nimport type { PendingView, ViewNode, ViewSnapshot } from './contracts.ts'\nimport { uiEn, uiZh } from './copy.ts'\n\nexport type LocaleSource = { getSnapshot?(): { active?: string }; subscribe?(listener: () => void): () => void }\n\n/** Ephemeral presentation state. Durable answers remain Session-owned; this store\n * only coordinates where an open card is being edited and local progress. */\nexport type ViewStatus = {\n  state: 'filling' | 'filled' | 'sending' | 'failed'\n  text: string\n  copyKey?: 'filling' | 'filled' | 'sending' | 'answerFailed' | 'fillFailed' | 'expired' | 'dismissFailed'\n}\nexport type ProgressRecord = { callId: string; title: string; view: ViewNode; at: number }\nexport type LiveSnapshot = ViewSnapshot & { originCallId: string }\ntype Store = ReturnType<typeof createViewStateStore>\nexport function createViewStateStore(locale?: LocaleSource) {\n  let statuses: Record<string, ViewStatus> = {}\n  let pending: Record<string, PendingView> = {}\n  let progress: Record<string, ProgressRecord> = {}\n  let snapshots: Record<string, LiveSnapshot> = {}\n  let bindings: Record<string, Record<string, unknown>> = {}\n  const listeners = new Set<() => void>()\n  const publish = () => { for (const fn of [...listeners]) fn() }\n  return {\n    subscribe: (fn: () => void) => { listeners.add(fn); return () => { listeners.delete(fn) } },\n    status: (callId: string) => statuses[callId],\n    setStatus: (callId: string, status: ViewStatus | undefined) => {\n      statuses = { ...statuses }\n      if (status) statuses[callId] = status\n      else delete statuses[callId]\n      publish()\n    },\n    pending: (sessionId: string) => Object.values(pending).filter(item => item.sessionId === sessionId),\n    pendingFor: (sessionId: string, callId: string) => Object.values(pending).find(item => item.sessionId === sessionId && item.callId === callId),\n    setPending: (record: PendingView | undefined) => {\n      pending = { ...pending }\n      if (record) {\n        // The Host keeps one live answer per session, not a history of pending cards.\n        for (const key of Object.keys(pending)) if (key.startsWith(`${record.sessionId}:`)) delete pending[key]\n        pending[`${record.sessionId}:${record.callId ?? record.id}`] = record\n      }\n      publish()\n    },\n    clearPending: (sessionId: string, callId: string) => {\n      const key = `${sessionId}:${callId}`\n      if (!(key in pending)) return\n      pending = { ...pending }\n      delete pending[key]\n      publish()\n    },\n    setProgress: (sessionId: string, record: Omit<ProgressRecord, 'at'>) => {\n      const current = progress[sessionId]\n      if (current?.callId === record.callId && current.title === record.title && current.view === record.view) return\n      progress = { ...progress, [sessionId]: { ...record, at: Date.now() } }\n      publish()\n    },\n    clearProgress: (sessionId: string) => {\n      if (!(sessionId in progress)) return\n      progress = { ...progress }\n      delete progress[sessionId]\n      publish()\n    },\n    progress: (sessionId: string) => progress[sessionId],\n    latest: (sessionId: string, viewId: string | undefined) => viewId ? snapshots[`${sessionId}:${viewId}`] : undefined,\n    setSnapshot: (record: LiveSnapshot) => {\n      const key = `${record.sessionId}:${record.id}`\n      const current = snapshots[key]\n      if (current && current.revision >= record.revision) return\n      const originCallId = current?.originCallId ?? record.originCallId\n      snapshots = { ...snapshots, [key]: { ...record, originCallId } }\n      publish()\n    },\n    values: (sessionId: string, viewId: string) => bindings[`${sessionId}:${viewId}`],\n    setValues: (sessionId: string, viewId: string, values: Record<string, unknown>) => {\n      bindings = { ...bindings, [`${sessionId}:${viewId}`]: values }\n      publish()\n    },\n    localeSnapshot: () => locale?.getSnapshot?.(),\n    localeSubscribe: (fn: () => void) => locale?.subscribe?.(fn) ?? (() => {}),\n  }\n}\n\nexport function useLiveSnapshot(store: Store, sessionId: string, viewId: string | undefined) {\n  return useSyncExternalStore(store.subscribe, () => store.latest(sessionId, viewId), () => store.latest(sessionId, viewId))\n}\nexport function useViewValues(store: Store, sessionId: string, viewId: string) {\n  return useSyncExternalStore(store.subscribe, () => store.values(sessionId, viewId), () => store.values(sessionId, viewId))\n}\n\nexport function useViewLocale(store: Store) {\n  return useSyncExternalStore(store.localeSubscribe, store.localeSnapshot, store.localeSnapshot)\n}\n/** Slot translation functions are stable identities. Explicitly read the active\n * locale so retained status text also changes when the user switches language. */\nexport function useViewT(store: Store, fallback: (key: string, params?: Record<string, unknown>) => string) {\n  const locale = useViewLocale(store)?.active?.toLowerCase()\n  return useMemo(() => (key: string, params?: Record<string, unknown>) => {\n    const table = locale?.startsWith('zh') ? uiZh : locale?.startsWith('en') ? uiEn : undefined\n    const text = key in (table ?? {}) ? table?.[key as keyof typeof uiZh] : fallback(key, params)\n    return String(text ?? key).replace(/\\{(\\w+)\\}/g, (_, name) => String(params?.[name] ?? `{${name}}`))\n  }, [locale, fallback])\n}\n\nexport function useViewStatus(store: Store, callId: string) {\n  return useSyncExternalStore(store.subscribe, () => store.status(callId), () => store.status(callId))\n}\nexport function useViewPending(store: Store, sessionId: string, callId: string) {\n  return useSyncExternalStore(store.subscribe, () => store.pendingFor(sessionId, callId), () => store.pendingFor(sessionId, callId))\n}\nexport function useLatestPending(store: Store, sessionId: string) {\n  return useSyncExternalStore(store.subscribe, () => store.pending(sessionId).at(-1), () => store.pending(sessionId).at(-1))\n}\nexport function useViewProgress(store: Store, sessionId: string) {\n  return useSyncExternalStore(store.subscribe, () => store.progress(sessionId), () => store.progress(sessionId))\n}\n","export type InputSnapshot = {\n  draft: string\n  phase: 'plain' | 'adjudicating' | 'claimed' | 'submitting' | 'sending'\n}\nexport type ComposerActions = {\n  captureInsertion(): unknown\n  insertText(text: string, span: unknown): boolean\n  setDraft(text: string): void\n  persistDraft(): void\n}\nexport type FillDraft = (input: { sessionId: string; text: string; viewId?: string }) => Promise<'filled' | 'rejected'>\n\nexport function fillComposerDraft(input: InputSnapshot, actions: ComposerActions | undefined, text: string, replace: boolean): boolean {\n  if (!actions || input.phase !== 'plain') return false\n  if (replace || input.draft.trim() === '') actions.setDraft(text)\n  else {\n    const captured = actions.captureInsertion()\n    const span = captured !== null && typeof captured === 'object'\n      ? { ...captured, start: input.draft.length, end: input.draft.length }\n      : captured\n    if (!actions.insertText(`\\n\\n${text}`, span)) return false\n  }\n  actions.persistDraft()\n  return true\n}\n","import { checkShownView } from './core/index.js'\nimport type { ShownView } from './contracts.ts'\n\nexport type TextPart = { kind: 'markdown' | 'view'; key: string; text: string; shown?: ShownView }\n/**\n * Single-fence-body compile result. 'partial' means JSON.parse failed, which a\n * streaming caller may keep waiting on; 'invalid' means the JSON parsed and\n * checkShownView rejected it, a definitive failure for the same text.\n */\nexport type DeepUiCompile =\n  | { state: 'complete'; shown: ShownView }\n  | { state: 'invalid'; error: string }\n  | { state: 'partial' }\n\n/**\n * Compile one deepui/deep-view fence body: JSON.parse, then checkShownView on\n * either {title, view} or a bare ViewNode. Callers decide how to present\n * 'partial' while streaming versus after the fence is final.\n */\nexport function compileDeepUi(body: string): DeepUiCompile {\n  try {\n    const payload: unknown = JSON.parse(body)\n    const record = payload !== null && typeof payload === 'object' && !Array.isArray(payload) ? payload as Record<string, unknown> : undefined\n    const sent = record && Object.hasOwn(record, 'view') ? record.view : payload\n    const title = record && Object.hasOwn(record, 'view') && typeof record.title === 'string' ? record.title : undefined\n    const shown = checkShownView(title, sent) as ShownView | { error: string }\n    return 'error' in shown ? { state: 'invalid', error: shown.error } : { state: 'complete', shown }\n  } catch {\n    return { state: 'partial' }\n  }\n}\ntype Fence = { at: number; marker: string; language: string; contentStart: number }\nconst OPEN = /(^|\\n)(`{3,}|~{3,})([^\\r\\n`~]*)(?:\\n|$)/g\nfunction closeFence(source: string, from: number, marker: string): { at: number; next: number } | undefined {\n  const pattern = new RegExp(`(^|\\\\n)${marker[0]}{${marker.length},}[ \\\\t]*(?:\\\\n|$)`, 'g')\n  pattern.lastIndex = from\n  const match = pattern.exec(source)\n  if (!match) return undefined\n  return { at: match.index + match[1].length, next: pattern.lastIndex }\n}\nfunction nextFence(source: string, from: number): Fence | undefined {\n  OPEN.lastIndex = from\n  const match = OPEN.exec(source)\n  if (!match) return undefined\n  const at = match.index + match[1].length\n  return { at, marker: match[2], language: match[3].trim().split(/[ \\t]/, 1)[0], contentStart: at + match[0].length - match[1].length }\n}\nfunction plainFence(source: string, start: Fence): Fence {\n  const closed = closeFence(source, start.contentStart, start.marker)\n  return closed ? nextFence(source, closed.next) ?? { at: source.length, marker: '', language: '', contentStart: source.length } : { at: source.length, marker: '', language: '', contentStart: source.length }\n}\n\n/**\n * Scan all top-level fences, not just Deep View ones. This prevents a nested\n * ```deepui example inside an ordinary fence from becoming a live component.\n * Unknown, malformed and unfinished fences remain verbatim Markdown.\n */\nexport function parseDeepUi(source: string): TextPart[] {\n  const parts: TextPart[] = []\n  let offset = 0\n  const markdown = (end: number) => {\n    if (end <= offset) return\n    parts.push({ kind: 'markdown', key: `m-${offset}`, text: source.slice(offset, end) })\n  }\n  while (offset < source.length) {\n    const start = nextFence(source, offset)\n    if (!start || start.at >= source.length) break\n    if (start.language !== 'deepui' && start.language !== 'deep-view') {\n      const next = plainFence(source, start)\n      if (next.at >= source.length) break\n      offset = next.at\n      continue\n    }\n    markdown(start.at)\n    const close = closeFence(source, start.contentStart, start.marker)\n    if (!close) {\n      parts.push({ kind: 'markdown', key: `m-${start.at}`, text: source.slice(start.at) })\n      return parts\n    }\n    const body = source.slice(start.contentStart, close.at)\n    // A closed fence's compile result is final here: 'partial' and 'invalid'\n    // alike fall back to verbatim Markdown, only 'complete' becomes a view.\n    const compiled = compileDeepUi(body)\n    parts.push(compiled.state === 'complete'\n      ? { kind: 'view', key: `v-${start.at}`, text: body, shown: compiled.shown }\n      : { kind: 'markdown', key: `m-${start.at}`, text: source.slice(start.at, close.next) })\n    offset = close.next\n  }\n  markdown(source.length)\n  return parts\n}\n","// Inline deepui/deep-view fence renderer for the 'conversation.chat.markdown.fence'\n// hoc layer. Streaming keeps a quiet placeholder, a complete body mounts the\n// live WidgetCard even mid-stream, and a final invalid body keeps the raw code\n// reachable. Answers only fill the composer; nothing submits for the user.\nimport { useCallback, useMemo, useState, type ReactNode } from 'react'\nimport { Button, MarkdownText } from '@deepseek-ai/dsh-client-ui-primitives'\nimport { validateViewAnswer } from './core/index.js'\nimport type { ShownView } from './contracts.ts'\nimport { compileDeepUi } from './parser.ts'\nimport { answerText } from './answer-text.ts'\nimport { fillComposerDraft, type ComposerActions, type InputSnapshot } from './draft.ts'\nimport { WidgetCard, type MarkdownProps, type ViewLabels } from './widget.tsx'\nimport type { ViewT } from './ui.tsx'\n\n/** Standard props a session-scoped markdown fence layer receives, plus owner content. */\nexport type DeepViewFenceProps = {\n  /** The fence body text, complete or still streaming. */\n  code: string\n  /** True while the model is still writing this fence. */\n  streaming: boolean\n  /** Owner-rendered raw code block; kept for the final invalid fallback. */\n  children?: ReactNode\n  /** UI-key translator mapped by the registration layer (deep-view locale). */\n  t(key: string, params?: Record<string, unknown>): string\n  inputActions?: ComposerActions\n  useInput?<T>(selector: (snapshot: InputSnapshot) => T, equal?: (left: T, right: T) => boolean): T\n}\n\ntype FillStatus = { state: 'filled' } | { state: 'fillFailed' } | { state: 'failed'; text: string }\ntype DraftChoice = { action: string; values: Record<string, unknown> }\n\n// Mirrors client.tsx viewT: maps the widget layer's English keys onto the\n// plugin locale ids the registration's `t` speaks.\nconst VIEW_KEYS: Record<string, string> = {\n  Copy: 'copy', Copied: 'copied', Footnotes: 'footnotes', Chart: 'chart', 'Chart options': 'chartOptions',\n  'View as chart': 'viewAsChart', 'View as table': 'viewAsTable', 'Copy data': 'copyData', 'Chart {n}': 'chartNumber',\n  Value: 'value', Series: 'series', View: 'view', Sources: 'sources', Progress: 'progress', 'Your answer': 'yourAnswer',\n  'Local preview only; this card does not send an answer.': 'local',\n  Options: 'options', Submit: 'submit', Cancel: 'cancel', Confirm: 'confirm', Send: 'send', Selected: 'selected',\n  'Fill composer': 'fillDraft', Steps: 'steps',\n  'Node graph': 'nodeGraph', 'Select a node': 'selectNode', 'Nothing to explore': 'nothingToExplore',\n  '{n} selected: {values}': 'selectedValues', 'Drag to select a range; double-click to clear': 'exploreIntervalHint',\n  'Click points to select; double-click to clear': 'explorePointHint', 'The chart could not be drawn.': 'exploreFailed',\n  'Data: {n} rows': 'dataRows', 'Showing {shown} of {n} rows': 'dataTruncated', Map: 'map', 'Map marker': 'mapMarker',\n  'Zoom in': 'zoomIn', 'Zoom out': 'zoomOut', 'Reset bearing to north': 'resetBearing',\n  'Map is unavailable in this environment.': 'mapUnavailable', 'Map failed to load.': 'mapFailed',\n  'You can still pick a location below.': 'mapFallback', Locations: 'locations',\n}\nexport const fenceViewT = (t: DeepViewFenceProps['t']): ViewT => (key, params) => {\n  const mapped = VIEW_KEYS[key] ?? key\n  return t(mapped, params) === mapped\n    ? key.replace(/\\{(\\w+)\\}/g, (_, name) => String(params?.[name] ?? `{${name}}`))\n    : t(mapped, params)\n}\n\nfunction FenceMarkdown(props: Parameters<typeof MarkdownText>[0]) {\n  return <MarkdownText {...props} />\n}\n\n/** Title peek for the quiet streaming placeholder; undefined unless the string is already complete. */\nexport function streamTitle(code: string): string | undefined {\n  const match = /\"title\"\\s*:\\s*\"((?:\\\\.|[^\"\\\\])*)\"/.exec(code)\n  if (!match) return undefined\n  try {\n    const title: unknown = JSON.parse(`\"${match[1]}\"`)\n    return typeof title === 'string' ? title : undefined\n  } catch {\n    return undefined\n  }\n}\n\nexport function DeepViewFence(props: DeepViewFenceProps) {\n  const compiled = useMemo(() => compileDeepUi(props.code), [props.code])\n  const shown: ShownView | undefined = compiled.state === 'complete' ? compiled.shown : undefined\n  const t = props.t\n  const viewT = useMemo(() => fenceViewT(t), [t])\n  const labels = useMemo<ViewLabels>(() => ({\n    code: { copyLabel: t('copy'), copiedLabel: t('copied') },\n    footnotes: t('footnotes'),\n  }), [t])\n  const input = props.useInput?.(value => value) ?? { draft: '', phase: 'plain' as const }\n  const [status, setStatus] = useState<FillStatus | null>(null)\n  const [draftChoice, setDraftChoice] = useState<DraftChoice | null>(null)\n  const canFill = props.inputActions !== undefined\n  const fill = useCallback((choice: DraftChoice, replace = false) => {\n    if (!shown) return\n    const checked = validateViewAnswer(shown.view, choice.action, choice.values)\n    if (checked.error !== undefined) {\n      setStatus({ state: 'failed', text: String(checked.error) })\n      setDraftChoice(null)\n      return\n    }\n    const text = answerText(shown, choice.action, checked)\n    const accepted = fillComposerDraft(input, props.inputActions, text, replace)\n    setStatus(accepted ? { state: 'filled' } : { state: 'fillFailed' })\n    setDraftChoice(null)\n  }, [shown, input, props.inputActions])\n  const onFillDraft = useCallback((action: string, values: Record<string, unknown>) => {\n    if (input.draft.trim() !== '') setDraftChoice({ action, values })\n    else fill({ action, values })\n  }, [input.draft, fill])\n\n  // Final invalid bodies fall back: never blank, and the raw code stays viewable.\n  if (compiled.state !== 'complete' && !props.streaming) {\n    return <div className=\"dvui-fence dvui-fence-failed\" role=\"group\" aria-label={t('invalid')}>\n      <p className=\"dvui-tool-error\" role=\"status\">{t('invalid')}</p>\n      {props.children ? <details className=\"dvui-fence-source\"><summary>{t('code')}</summary><div className=\"dvui-fence-code\">{props.children}</div></details> : null}\n    </div>\n  }\n  // Still streaming: complete JSON mounts the card immediately; anything else\n  // waits behind one static placeholder, so a mid-stream parse miss never flickers.\n  if (!shown) {\n    const title = streamTitle(props.code)\n    return <div className=\"dvui-fence dvui-fence-pending\" role=\"status\" aria-label={title ?? t('preparing')}>\n      {title ? <p className=\"dvui-fence-title\">{title}</p> : null}\n      <span className=\"dvui-fence-hint\">{t('preparing')}</span>\n    </div>\n  }\n  return <div className=\"dvui-fence dvui-fence-card\">\n    <WidgetCard title={shown.title} view={shown.view} ButtonComponent={Button}\n      onFillDraft={canFill ? onFillDraft : undefined}\n      localOnly={!canFill}\n      t={viewT} labels={labels} Markdown={FenceMarkdown} />\n    {status ? <p className={status.state === 'filled' ? 'dvui-status' : 'dvui-tool-error'} role={status.state === 'filled' ? 'status' : 'alert'}>\n      {status.state === 'filled' ? t('filled') : status.state === 'fillFailed' ? t('fillFailed') : status.text}\n    </p> : null}\n    {draftChoice ? <div className=\"dvui-draft-choice\" role=\"group\" aria-label={t('draftConflict')}>\n      <p>{t('draftConflict')}</p><div className=\"dvui-actions\">\n        <Button variant=\"primary\" onClick={() => void fill(draftChoice, true)}>{t('replaceDraft')}</Button>\n        <Button onClick={() => void fill(draftChoice)}>{t('appendDraft')}</Button>\n        <Button onClick={() => setDraftChoice(null)}>{t('cancel')}</Button>\n      </div>\n    </div> : null}\n  </div>\n}\n","import type { Context } from '@deepseek-ai/cordis'\nimport { useCallback, useEffect, useMemo, useRef, useState, useSyncExternalStore, type ReactElement } from 'react'\