ue as MapLocation).coordinates)\n\n/** Everything the component needs from the node, defensively filtered.\n * A malformed coordinate or entry is dropped, never trusted or thrown on. */\nexport function mapData(node: { center?: unknown; zoom?: unknown; locations?: unknown; routes?: unknown }): MapData {\n  const locations = (Array.isArray(node.locations) ? node.locations : []).filter(isLocation)\n  const routes = (Array.isArray(node.routes) ? node.routes : []).filter((route): route is MapRoute =>\n    route !== null && typeof route === 'object'\n    && Array.isArray((route as MapRoute).coordinates) && (route as MapRoute).coordinates.length >= 2\n    && (route as MapRoute).coordinates.every(isLngLat))\n  const center = isLngLat(node.center) ? [node.center[0], node.center[1]] as LngLat\n    : locations.length > 0 ? [locations[0].coordinates[0], locations[0].coordinates[1]] as LngLat\n    : undefined\n  const zoom = typeof node.zoom === 'number' && Number.isFinite(node.zoom)\n    ? Math.max(0, Math.min(22, node.zoom))\n    : locations.length <= 1 ? 4 : 3\n  return { locations, routes, center, zoom }\n}\n\n/** Routes rendered as one FeatureCollection of LineStrings. `setData` is the\n * controlled update path: the component owns source and layer ids entirely. */\nexport function routesToGeoJSON(routes: MapRoute[]): RouteGeoJSON {\n  return {\n    type: 'FeatureCollection',\n    features: routes.map(route => ({\n      type: 'Feature',\n      geometry: { type: 'LineString', coordinates: route.coordinates.map(pair => [pair[0], pair[1]]) },\n      properties: { label: typeof route.label === 'string' ? route.label : '' },\n    })),\n  }\n}\n\n// Canvas paint cannot read CSS custom properties, so the route colour is\n// resolved once from the host token, falling back to the plugin accent blue.\nfunction lineColor(): string {\n  try {\n    const color = typeof getComputedStyle === 'function'\n      ? getComputedStyle(document.documentElement).getPropertyValue('--dsw-alias-state-business-primary').trim()\n      : ''\n    return color !== '' ? color : 'currentColor'\n  } catch {\n    return 'currentColor'\n  }\n}\n\nimport { loadMapLibre } from './map-loader.ts'\n\nfunction webglAvailable(): boolean {\n  if (typeof document === 'undefined' || typeof WebGLRenderingContext === 'undefined' && typeof WebGL2RenderingContext === 'undefined') return true\n  try {\n    const canvas = document.createElement('canvas')\n    return canvas.getContext('webgl2') !== null || canvas.getContext('webgl') !== null\n  } catch { return false }\n}\n\nexport function MapView({ node, lookup, setInput, t = english, editable = true }: RichNodeProps & { editable?: boolean }) {\n  const id = typeof node.id === 'string' ? node.id : ''\n  const data = useMemo(() => mapData(node), [node])\n  const geo = useMemo(() => routesToGeoJSON(data.routes), [data.routes])\n  // The view scope throws for a name the view never declared; a map without a\n  // valid input id is read-only instead of crashing the card.\n  const selected = (() => {\n    try { return id !== '' ? lookup(id) : undefined } catch { return undefined }\n  })()\n  const selectedId = typeof selected === 'string' && selected !== '' ? selected : null\n  const selectedLocation = data.locations.find(location => location.id === selectedId) ?? null\n  const selectedRef = useRef(selectedId)\n  selectedRef.current = selectedId\n\n  const hostRef = useRef<HTMLDivElement>(null)\n  const mapRef = useRef<MapLike | null>(null)\n  const markersRef = useRef<{ button: HTMLButtonElement; location: MapLocation; marker: MarkerLike }[]>([])\n  const readyRef = useRef(false)\n  const geoRef = useRef(geo)\n  geoRef.current = geo\n  const selectRef = useRef<(location: MapLocation) => void>(() => {})\n  const [failure, setFailure] = useState<'init' | 'style' | null>(null)\n  const failureRef = useRef<typeof failure>(null)\n  failureRef.current = failure\n\n  const choose = (location: MapLocation) => {\n    if (id === '' || !editable) return\n    setInput(id, selectedId === location.id ? '' : location.id)\n  }\n  selectRef.current = choose\n\n  const syncRoutes = () => {\n    const map = mapRef.current\n    if (!map || !readyRef.current || failureRef.current !== null) return\n    try {\n      const source = map.getSource(MAP_ROUTE_SOURCE) as { setData?(data: unknown): void } | undefined\n      if (source?.setData !== undefined) source.setData(geoRef.current)\n      else {\n        map.addSource(MAP_ROUTE_SOURCE, { type: 'geojson', data: geoRef.current })\n        map.addLayer({\n          id: MAP_ROUTE_LAYER, type: 'line', source: MAP_ROUTE_SOURCE,\n          layout: { 'line-cap': 'round', 'line-join': 'round' },\n          paint: { 'line-color': lineColor(), 'line-width': 3, 'line-opacity': 0.85 },\n        })\n      }\n    } catch { /* a source race must never break the card; the list below still works */ }\n  }\n\n  useEffect(() => {\n    const host = hostRef.current\n    if (!host) return undefined\n    let cancelled = false\n    const subscriptions: { unsubscribe(): void }[] = []\n    const markers: typeof markersRef.current = []\n    let map: MapLike | null = null\n    setFailure(null)\n    failureRef.current = null\n    readyRef.current = false\n    void (async () => {\n      let lib: MapLibreLike\n      try {\n        lib = await loadMapLibre()\n      } catch {\n        if (!cancelled) setFailure('init')\n        return\n      }\n      if (cancelled) return\n      if (!webglAvailable()) { if (!cancelled) setFailure('init'); return }\n      try {\n        map = new lib.Map({\n          container: host,\n          style: DEFAULT_MAP_STYLE,\n          ...(data.center !== undefined ? { center: data.center } : {}),\n          zoom: data.zoom,\n          attributionControl: { compact: true },\n          locale: {\n            'Map.Title': t('Map'),\n            'Marker.Title': t('Map marker'),\n            'NavigationControl.ZoomIn': t('Zoom in'),\n            'NavigationControl.ZoomOut': t('Zoom out'),\n            'NavigationControl.ResetBearing': t('Reset bearing to north'),\n          },\n        })\n      } catch {\n        if (!cancelled) setFailure('init')\n        return\n      }\n      if (cancelled) { try { map.remove() } catch { /* noop */ } return }\n      mapRef.current = map\n      subscriptions.push(\n        // Before 'load' an error means the style (or WebGL) failed: the tiles\n        // themselves cannot exist yet. After load, tile-level errors are\n        // logged by the browser and must not blank a working map.\n        map.on('error', () => { if (!readyRef.current) { failureRef.current = 'style'; setFailure('style') } }),\n        map.on('load', () => {\n          readyRef.current = true\n          try { map?.addControl(new lib.NavigationControl({ showCompass: false }), 'top-right') } catch { /* controls are decoration */ }\n          syncRoutes()\n        }),\n      )\n      for (const location of data.locations) {\n        const button = document.createElement('button')\n        button.type = 'button'\n        button.className = 'dvui-map-pin'\n        button.disabled = !editable\n        button.setAttribute('aria-label', location.label)\n        button.setAttribute('aria-pressed', location.id === selectedRef.current ? 'true' : 'false')\n        button.setAttribute('title', location.label)\n        button.addEventListener('click', event => { event.stopPropagation(); selectRef.current(location) })\n        try {\n          const marker = new lib.Marker({ element: button }).setLngLat([location.coordinates[0], location.coordinates[1]]).addTo(map)\n          markers.push({ button, location, marker })\n        } catch { /* a dead marker still leaves the list below */ }\n      }\n      markersRef.current = markers\n    })()\n    return () => {\n      cancelled = true\n      readyRef.current = false\n      for (const { marker } of markers) { try { marker.remove() } catch { /* noop */ } }\n      markersRef.current = []\n      for (const subscription of subscriptions) { try { subscription.unsubscribe() } catch { /* noop */ } }\n      mapRef.current = null\n      if (map) { try { map.remove() } catch { /* noop */ } }\n    }\n  // Rebuild the map for a new model snapshot or a change in edit permission;\n  // selection remains in the view scope and is restored by selectedRef.\n  }, [data, editable])\n\n  // Keep route geometry and marker selection state in sync with the view\n  // scope; both are idempotent on an unmounted or unready map.\n  useEffect(() => { syncRoutes() }, [geo])\n  useEffect(() => {\n    for (const { button, location } of markersRef.current) {\n      button.setAttribute('aria-pressed', location.id === selectedId ? 'true' : 'false')\n      button.style.background = location.id === selectedId ? 'var(--dsw-alias-state-success-primary)' : 'var(--dsw-alias-state-business-primary)'\n    }\n  }, [selectedId])\n\n  return <div className=\"dvui-map\">\n    {node.label !== undefined ? <div className=\"dvui-input-label\">{node.label}</div> : null}\n    <div className=\"dvui-map-frame\">\n      <div ref={hostRef} className=\"dvui-map-host\" />\n      {failure !== null ? <div className=\"dvui-map-notice\" role=\"status\">\n        <span>{t(failure === 'init' ? 'Map is unavailable in this environment.' : 'Map failed to load.')}</span>\n        {data.locations.length > 0 ? <small>{t('You can still pick a location below.')}</small> : null}\n      </div> : null}\n    </div>\n    {selectedLocation !== null ? <div className=\"dvui-map-detail\" role=\"status\">\n      <span>{selectedLocation.label}</span>\n      {typeof selectedLocation.detail === 'string' && selectedLocation.detail !== ''\n        ? <span>{selectedLocation.detail}</span> : null}\n    </div> : null}\n    {data.locations.length > 0 ? <div className=\"dvui-map-locations\" role=\"group\" aria-label={t('Locations')}>\n      {data.locations.map(location => <button\n        key={location.id} type=\"button\" className=\"dvui-map-location\"\n        aria-pressed={location.id === selectedId}\n        title={typeof location.detail === 'string' ? location.detail : undefined}\n        disabled={!editable}\n        onClick={() => choose(location)}\n      >{location.label}</button>)}\n    </div> : null}\n  </div>\n}\n","import { lazy, Suspense } from 'react'\nimport type { RichNodeProps } from './rich-types.ts'\nimport { english } from './ui.tsx'\n\n// Load heavy third-party runtimes only when the model actually uses them.\n// This also keeps ordinary form/Markdown DOM initialization independent.\nconst MathView = lazy(() => import('./math.tsx').then(module => ({ default: module.MathView })))\nconst FlowView = lazy(() => import('./flow.tsx').then(module => ({ default: module.FlowView })))\nconst ExploreView = lazy(() => import('./explore.tsx').then(module => ({ default: module.ExploreView })))\nconst MapView = lazy(() => import('./map.tsx').then(module => ({ default: module.MapView })))\n\nexport function RichNode(props: RichNodeProps & { editable?: boolean }) {\n  const { node, t = english } = props\n  const Component = node.type === 'math' ? MathView : node.type === 'flow' ? FlowView : node.type === 'explore' ? ExploreView : node.type === 'map' ? MapView : null\n  if (!Component) return null\n  return <Suspense fallback={<div className=\"dvui-tool-loading\" role=\"status\">{t('Composing interface…')}</div>}>\n    <Component {...props} />\n  </Suspense>\n}\n","// Widget composition adapted from deep-view/src/react/card.js (Apache-2.0).\n// DSH migration: html/PNG export/Bot persistence are excluded. Local controls\n// remain live; only a supplied onSubmit callback may deliver an answer.\nimport { Fragment, useCallback, useEffect, useId, useMemo, useRef, useState } from 'react'\nimport type { ComponentType } from 'react'\nimport { asText, choiceValue, hasInputs, inputDefault, mathDefaults, resolve, viewInputs, viewScope } from './core/index.js'\nimport { isSourceItem, isStepItem, type ViewNode } from './contracts.ts'\nimport { WidgetChart, type ChartHandle } from './chart.tsx'\nimport { CheckIcon, CopyIcon, DotsIcon, InfoIcon, LinkIcon, Segmented, TableIcon, english, keyLetter, type ViewT } from './ui.tsx'\nimport { RichNode } from './rich-lazy.tsx'\n\n// Structural twin of the official MarkdownLabels: the widget layer stays\n// runtime-neutral, and any component accepting this shape (the official\n// MarkdownText included) is assignable.\nexport type MarkdownProps = { text: string; streaming?: boolean; labels: ViewLabels; variant?: 'body' | 'compact' }\nexport type ViewLabels = {\n  code: { copyLabel: string; copiedLabel: string; toolbarLabels?: { codeLabel: string; wrapLabel: string; unwrapLabel: string } }\n  footnotes: string\n}\nexport type Answer = { id: string; action: string; values: Record<string, unknown>; revision?: number }\nexport type WidgetCardProps = {\n  title?: string\n  view: ViewNode\n  onSubmit?: (action: string, values: Record<string, unknown>) => void\n  /** Write the answer as composer draft instead of answering directly. Never sends. */\n  onFillDraft?: (action: string, values: Record<string, unknown>) => void\n  onDismiss?: () => void\n  busy?: boolean\n  settled?: boolean\n  answer?: Answer | null\n  t?: ViewT\n  labels?: ViewLabels\n  Markdown?: ComponentType<MarkdownProps>\n  localOnly?: boolean\n  /** Ephemeral local state shared across the dock and settled reply surfaces. */\n  values?: Record<string, unknown>\n  onValuesChange?: (values: Record<string, unknown>) => void\n  /** Optional explanation for an interactive preview answered in another surface. */\n  localNote?: string\n  /** Browser hosts inject their native button without coupling the shared widget to DSH. */\n  ButtonComponent?: ButtonHost\n}\ntype Ctx = {\n  values: Record<string, unknown>\n  setInput(id: string, value: unknown): void\n  lookup(name: string): unknown\n  locked: boolean\n  answerLocked: boolean\n  fillLocked: boolean\n  editable: boolean\n  busy: boolean\n  settled: boolean\n  answer?: Answer | null\n  onSubmit?: (action: string, values: Record<string, unknown>) => void\n  onFillDraft?: (action: string, values: Record<string, unknown>) => void\n  ButtonComponent?: ButtonHost\n  registerChart(key: string, handle: ChartHandle): (() => void) | void\n  refreshCharts(): void\n}\n// Direct-answer controls (Submit/Confirm/Cancel) stay rendered disabled when a\n// card answers nowhere, but a fill-only card hides them: a permanently disabled\n// button that looks usable is a fake action, while Fill composer does the work.\nconst directAnswer = (ctx: Ctx) => ctx.onSubmit !== undefined || ctx.onFillDraft === undefined\nconst TONES = ['good', 'warn', 'bad']\nconst CALLOUT_TONES = ['info', 'good', 'warn', 'bad']\nconst optionsOf = (node: ViewNode) => (Array.isArray(node.options) ? node.options : []) as { label: string; value?: string | number | boolean; description?: string }[]\nconst fieldsOf = (node: ViewNode) => (Array.isArray(node.fields) ? node.fields : [])\nconst sourcesOf = (node: ViewNode) => (Array.isArray(node.items) ? node.items : []).filter(isSourceItem)\nconst stepsOf = (node: ViewNode) => (Array.isArray(node.items) ? node.items : []).filter(isStepItem)\nconst cellText = (value: unknown) => value === null || value === undefined ? '' : typeof value === 'object' ? JSON.stringify(value) : asText(value)\nconst NUMERIC_CELL = /^[-+]?[\\d.,]+\\s?(%|[a-zA-Z]{1,4})?$/\nfunction hasType(node: ViewNode, types: Set<string>): boolean {\n  return types.has(node.type) || (Array.isArray(node.children) && node.children.some(child => hasType(child, types)))\n}\nconst answerValues = (answer: Answer | null | undefined, node: ViewNode) => answer != null && answer.action === node.id ? answer.values : undefined\nconst withUnit = (value: unknown, unit?: string) => `${asText(value)}${unit ? ` ${unit}` : ''}`\nconst grouped = (value: unknown) => typeof value === 'number' && Number.isFinite(value) ? value.toLocaleString('en-US', { maximumFractionDigits: 6 }) : asText(value)\nexport type ButtonHost = ComponentType<React.ButtonHTMLAttributes<HTMLButtonElement> & { variant?: 'primary' | 'ghost' | 'outline' | 'toolbar'; size?: 'sm' | 'md' }>\nfunction ActionButton({ primary = false, className = '', children, host: Host, ...props }: React.ButtonHTMLAttributes<HTMLButtonElement> & { primary?: boolean; host?: ButtonHost }) {\n  const classes = `${primary ? 'dvui-submit' : 'dvui-button'} ${className}`\n  return Host ? <Host variant={primary ? 'primary' : 'ghost'} size=\"sm\" className={classes} {...props}>{children}</Host>\n    : <button type={props.type ?? 'button'} className={classes} {...props}>{children}</button>\n}\nfunction FallbackMarkdown({ text }: MarkdownProps) { return <span>{text}</span> }\n\nfunction OptionsInput({ node, ctx, t }: { node: ViewNode; ctx: Ctx; t: ViewT }) {\n  const [picked, setPicked] = useState<string[]>([])\n  const options = optionsOf(node)\n  const multi = node.multi === true\n  // A card that can fill a draft needs a pick first, so one-tap submit becomes\n  // select-then-act only while filling is available; plain cards keep the\n  // instant single-tap answer.\n  const staged = multi || ctx.onFillDraft !== undefined\n  const choose = (label: string) => {\n    if (!ctx.editable) return\n    if (multi) setPicked(current => current.includes(label) ? current.filter(item => item !== label) : [...current, label])\n    else if (staged) setPicked([label])\n    else ctx.onSubmit?.(node.id!, { selected: [label] })\n  }\n  const values = () => ({ selected: picked })\n  const onKey = (event: React.KeyboardEvent<HTMLDivElement>) => {\n    const index = event.key.toUpperCase().charCodeAt(0) - 65\n    if (index >= 0 && index < options.length && !event.ctrlKey && !event.metaKey && !event.altKey) { event.preventDefault(); choose(options[index].label) }\n  }\n  return <Fragment>\n    <div className=\"dvui-options\" role=\"group\" aria-label={t('Options')} onKeyDown={onKey}>{options.map((option, index) => {\n      const selected = staged && picked.includes(option.label)\n      return <button key={option.label} type=\"button\" className=\"dvui-option\" disabled={!ctx.editable} aria-pressed={staged ? selected : undefined} aria-keyshortcuts={keyLetter(index).toLowerCase()} onClick={() => choose(option.label)}>\n        <span className=\"dvui-key\" aria-hidden=\"true\">{keyLetter(index)}</span>\n        <span className=\"dvui-option-body\"><span className=\"dvui-option-label\">{option.label}</span>{option.description ? <span className=\"dvui-option-desc\">{option.description}</span> : null}</span>\n        {selected ? <span className=\"dvui-check\"><CheckIcon /></span> : null}\n      </button>\n    })}</div>\n    {staged ? <div className=\"dvui-actions\">\n      {ctx.onFillDraft ? <ActionButton host={ctx.ButtonComponent} disabled={ctx.fillLocked || picked.length === 0} onClick={() => ctx.onFillDraft?.(node.id!, values())}>{t('Fill composer')}</ActionButton> : null}\n      {directAnswer(ctx) ? <ActionButton host={ctx.ButtonComponent} primary disabled={ctx.answerLocked || picked.length === 0} onClick={() => ctx.onSubmit?.(node.id!, values())}>{t('Submit')}</ActionButton> : null}\n    </div> : null}\n  </Fragment>\n}\nfunction SettledOptions({ node, answer, t }: { node: ViewNode; answer?: Answer | null; t: ViewT }) {\n  const selected = answerValues(answer, node)?.selected\n  const chosen = Array.isArray(selected) ? selected : []\n  return <div className=\"dvui-options\" role=\"group\" aria-label={t('Your answer')}>{optionsOf(node).map(option => <div key={option.label} className=\"dvui-option\"><span className=\"dvui-option-body\"><span className=\"dvui-option-label\">{option.label}</span>{option.description ? <span className=\"dvui-option-desc\">{option.description}</span> : null}</span>{chosen.includes(option.label) ? <span className=\"dvui-check\" role=\"img\" aria-label={t('Selected')}><CheckIcon /></span> : null}</div>)}</div>\n}\nfunction ConfirmInput({ node, ctx, t }: { node: ViewNode; ctx: Ctx; t: ViewT }) {\n  return <div className=\"dvui-actions\">\n    {ctx.onFillDraft ? <ActionButton host={ctx.ButtonComponent} disabled={ctx.fillLocked} onClick={() => ctx.onFillDraft?.(node.id!, { confirmed: true })}>{t('Fill composer')}</ActionButton> : null}\n    {directAnswer(ctx) ? <ActionButton host={ctx.ButtonComponent} disabled={ctx.answerLocked} onClick={() => ctx.onSubmit?.(node.id!, { confirmed: false })}>{node.cancelLabel ?? t('Cancel')}</ActionButton> : null}\n    {directAnswer(ctx) ? <ActionButton host={ctx.ButtonComponent} primary disabled={ctx.answerLocked} onClick={() => ctx.onSubmit?.(node.id!, { confirmed: true })}>{node.confirmLabel ?? t('Confirm')}</ActionButton> : null}\n  </div>\n}\nfunction SettledConfirm({ node, answer, t }: { node: ViewNode; answer?: Answer | null; t: ViewT }) {\n  const confirmed = answerValues(answer, node)?.confirmed\n  if (typeof confirmed !== 'boolean') return <ConfirmInput node={node} ctx={{ answerLocked: true } as Ctx} t={t} />\n  return <span className=\"dvui-badge\">{confirmed ? node.confirmLabel ?? t('Confirm') : node.cancelLabel ?? t('Cancel')}</span>\n}\nfunction FormInput({ node, ctx, t }: { node: ViewNode; ctx: Ctx; t: ViewT }) {\n  const fields = fieldsOf(node)\n  const [draft, setDraft] = useState<Record<string, string>>(() => Object.fromEntries(fields.map(field => [field.id, field.value ?? ''])))\n  const values = () => ({ fields: Object.fromEntries(fields.map(field => [field.id, field.readOnly === true ? (field.value ?? '') : (draft[field.id] ?? '')])) })\n  // The primary action prefers a direct answer; a fill-only card (no onSubmit)\n  // falls back to writing the draft.\n  const act = ctx.onSubmit !== undefined ? ctx.onSubmit : ctx.onFillDraft\n  const submit = () => { if (ctx.editable) act?.(node.id!, values()) }\n  const cancel = () => { if (ctx.editable) ctx.onSubmit?.(node.id!, { canceled: true }) }\n  return <form className=\"dvui-form\" onSubmit={event => { event.prevent