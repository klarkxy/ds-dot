  return parts.join('; ')\n}\n\n// The inputs of an answer as `Label=value` pairs, for the Bot's history.\nexport function inputsSummary(view, inputs) {\n  if (!isRecord(inputs)) return ''\n  return viewInputs(view)\n    .filter(node => Object.hasOwn(inputs, node.id))\n    .map(node => `${node.label || node.id}=${inputText(node, inputs[node.id])}`)\n    .join('; ')\n}\n\nexport function answersSummary(view, inputs) {\n  if (!isRecord(inputs)) return ''\n  return viewInputs(view)\n    .filter(node => ['math', 'flow', 'explore', 'map'].includes(node.type) && Object.hasOwn(inputs, node.id))\n    .map(node => ({ id: node.id, ...richSelectionSummary(node, inputs[node.id]) }))\n}\n\n// -------------------------------------------------------------------------\n// Answers\n\nfunction interactiveNodes(node, found = []) {\n  walk(node, (item) => { if (INTERACTIVE.has(item.type)) found.push(item) })\n  return found\n}\n\n// `action` is the id of the component the user submitted. One submit settles\n// the whole card, so only that component's values are kept, plus the inputs'\n// values when the view has inputs.\nexport function validateViewAnswer(view, action, values) {\n  const nodes = interactiveNodes(view)\n  if (typeof action !== 'string' || action === '') return { error: `action: expected an interactive component id; allowed: ${allowed(nodes.map(node => node.id))}` }\n  const node = nodes.find(item => item.id === action)\n  if (node === undefined) return { error: `action: no interactive component with id ${quoted(action)}; allowed: ${allowed(nodes.map(item => item.id))}` }\n  if (!isRecord(values)) return { error: 'values: expected an object' }\n  const inputs = validateInputs(view, values.inputs)\n  if (inputs.error !== undefined) return inputs\n  const extra = inputs.inputs === undefined ? {} : { inputs: inputs.inputs }\n  if (node.type === 'submit') return { ...extra }\n  const own = node.type === 'options' ? validateOptions(node, values) : node.type === 'confirm' ? validateConfirm(values) : validateForm(node, values)\n  return own.error === undefined ? { ...own, ...extra } : own\n}\n\nfunction validateRichInput(node, value, at) {\n  if (node.type === 'flow') {\n    if (value !== '' && !(node.nodes ?? []).some(item => item.id === value)) return `${at}: expected a declared node id or an empty selection`\n  }\n  if (node.type === 'map') {\n    if (value !== '' && !(node.locations ?? []).some(item => item.id === value)) return `${at}: expected a declared location id or an empty selection`\n  }\n  if (node.type === 'math') {\n    if (!isRecord(value)) return `${at}: expected point coordinates`\n    const ids = (node.mathPoints ?? []).map(point => point.id)\n    if (Object.keys(value).some(key => !ids.includes(key))) return `${at}: unknown point`\n    for (const point of node.mathPoints ?? []) {\n      if (!pair(value[point.id]) || Math.abs(value[point.id][0]) > 1e6 || Math.abs(value[point.id][1]) > 1e6) return `${at}.${point.id}: expected finite [x, y] within ±1000000`\n    }\n  }\n  if (node.type === 'explore') {\n    if (node.select !== 'interval') {\n      // Point values are categories: the client picks on colorKey when the view\n      // declares one, else on xKey — so the answer must be a value a row has.\n      const category = node.colorKey ?? node.xKey\n      if (!Array.isArray(value) || value.length > node.data.length || value.some(item => !isScalar(item) || !node.data.some(row => row[category] === item))) return `${at}: expected declared category values`\n      if (new Set(value).size !== value.length) return `${at}: duplicate selection`\n    } else {\n      // Interval keys are the real field names only; the literal 'xKey'/'yKey'\n      // the old check admitted never reach the client.\n      if (!isRecord(value) || Object.keys(value).some(key => key !== node.xKey && key !== node.yKey)) return `${at}: expected a bounded interval`\n      for (const [key, range] of Object.entries(value)) {\n        if (!Array.isArray(range) || range.length !== 2 || !range.every(isNumber) || range[0] > range[1]) return `${at}.${key}: expected an ordered numeric range`\n      }\n    }\n  }\n  return undefined\n}\n\n// Every input of the view, as sent or else as the Bot set it.\nfunction validateInputs(view, sent) {\n  const nodes = viewInputs(view)\n  if (nodes.length === 0) return sent === undefined ? {} : { error: 'values.inputs: this view has no inputs' }\n  if (sent !== undefined && !isRecord(sent)) return { error: 'values.inputs: expected an object of input ids to values' }\n  const given = sent ?? {}\n  const ids = nodes.map(node => node.id)\n  const unknown = Object.keys(given).find(key => !ids.includes(key))\n  if (unknown !== undefined) return { error: `values.inputs.${unknown}: unknown input; allowed: ${allowed(ids)}` }\n  const inputs = {}\n  for (const node of nodes) {\n    const value = Object.hasOwn(given, node.id) ? given[node.id] : inputDefault(node)\n    const at = `values.inputs.${node.id}`\n    if (node.type === 'toggle' && typeof value !== 'boolean') return { error: `${at}: expected true or false` }\n    if (node.type === 'choice' && !(Array.isArray(node.options) ? node.options : []).some(option => choiceValue(option) === value)) return { error: `${at}: expected one of the options' values` }\n    if (node.type === 'slider' || node.type === 'number') {\n      if (!isNumber(value)) return { error: `${at}: expected a number` }\n      if ((node.min !== undefined && value < node.min) || (node.max !== undefined && value > node.max)) return { error: `${at}: expected a number from ${node.min ?? '-∞'} to ${node.max ?? '∞'}` }\n    }\n    const richError = validateRichInput(node, value, at)\n    if (richError !== undefined) return { error: richError }\n    inputs[node.id] = value\n  }\n  return { inputs }\n}\n\nfunction validateOptions(node, values) {\n  if (!Array.isArray(values.selected)) return { error: 'values.selected: expected an array of option labels' }\n  const labels = new Set((node.options ?? []).map(option => option?.label))\n  const picked = values.selected.filter(label => typeof label === 'string' && labels.has(label))\n  const selected = node.multi === true ? [...new Set(picked)] : picked.slice(0, 1)\n  if (selected.length === 0) return { error: 'values.selected: select at least one option' }\n  return { selected }\n}\n\nfunction validateConfirm(values) {\n  if (typeof values.confirmed !== 'boolean') return { error: 'values.confirmed: expected a boolean' }\n  return { confirmed: values.confirmed }\n}\n\nfunction validateForm(node, values) {\n  // A cancel is its own answer: no field values are read or stored.\n  if (values.canceled === true) return { canceled: true }\n  if (!isRecord(values.fields)) return { error: 'values.fields: expected an object of field ids to strings' }\n  const declaredFields = (node.fields ?? []).filter(field => typeof field?.id === 'string')\n  const declared = declaredFields.map(field => field.id)\n  const byId = new Map(declaredFields.map(field => [field.id, field]))\n  const allowedIds = new Set(declared)\n  const fields = {}\n  for (const [key, value] of Object.entries(values.fields)) {\n    if (!allowedIds.has(key)) return { error: `values.fields.${key}: unknown field; allowed: ${allowed(declared)}` }\n    if (typeof value !== 'string') return { error: `values.fields.${key}: expected a string` }\n    if (value.length > MAX_TEXT) return { error: `values.fields.${key}: ${value.length} characters exceeds the limit of ${MAX_TEXT}` }\n    const spec = byId.get(key)\n    // A read-only field answers what the card declared, not what was sent.\n    fields[key] = spec?.readOnly === true ? (spec.value ?? '') : value\n  }\n  return { fields }\n}\n","export {\n  CHART_KINDS, VIEW_BYTE_LIMIT, answersSummary, asText, checkShownView, choiceValue, hasInputs,\n  inputDefault, inputsSummary, isFormula, mathDefaults, normalizeView, resolve, validateView,\n  validateViewAnswer, viewBindings, viewBytes, viewInputs, viewScope, viewSummary,\n} from './views.js'\nexport { FORMULA_FUNCTIONS, compileFormula, createScope, evaluate, isName, show } from './formula.js'\n","export type PluginLogLevel = 'debug' | 'info' | 'warn' | 'error' | 'fault'\n\nexport const PLUGIN_LOG_LEVELS: readonly PluginLogLevel[] = ['debug', 'info', 'warn', 'error', 'fault']\nexport const DEFAULT_PLUGIN_LOG_LEVEL: PluginLogLevel = 'info'\nexport const PLUGIN_LOG_MAX_MESSAGE_CHARS = 16_000\nexport const PLUGIN_LOG_MAX_CONTEXT_CHARS = 8_000\n\nexport type PluginLogScalar = string | number | boolean | null\nexport type PluginLogContext = Record<string, PluginLogScalar | undefined>\n\nexport interface PluginLogInput {\n  level: PluginLogLevel\n  event: string\n  message: string\n  context?: PluginLogContext\n  error?: unknown\n}\n\nexport interface PluginLogError {\n  name: string\n  message: string\n  stack?: string\n  code?: string\n}\n\nexport interface PluginLogEntry {\n  version: 1\n  at: string\n  level: PluginLogLevel\n  source: string\n  surface: 'host' | 'client'\n  profile?: string\n  event: string\n  message: string\n  pid?: number\n  context?: Record<string, PluginLogScalar>\n  error?: PluginLogError\n}\n\nexport interface PluginLogger {\n  readonly source: string\n  readonly file: string | null\n  readonly lastWriteError: string | null\n  debug(event: string, message: string, context?: PluginLogContext): boolean\n  info(event: string, message: string, context?: PluginLogContext): boolean\n  warn(event: string, message: string, error?: unknown, context?: PluginLogContext): boolean\n  error(event: string, message: string, error?: unknown, context?: PluginLogContext): boolean\n  fault(event: string, message: string, error?: unknown, context?: PluginLogContext): boolean\n  write(input: PluginLogInput): boolean\n  child(context: PluginLogContext): PluginLogger\n}\n\nconst SOURCE_RE = /^[a-z][a-z0-9-]{0,63}$/\nconst EVENT_RE = /^[a-z][a-z0-9._-]{0,127}$/\nconst CONTEXT_KEY_RE = /^[a-zA-Z][a-zA-Z0-9._-]{0,63}$/\nconst SECRET_KEY_RE = /(?:api[_-]?key|access[_-]?token|refresh[_-]?token|bearer|authorization|cookie|set[_-]?cookie|nonce|credential|private[_-]?key|password|secret|app[_-]?secret|client[_-]?secret|z_c0|d_c0)$/i\n\nconst CHAT_PAYLOAD_RE =\n  /\"role\"\\s*:\\s*\"(?:system|user|assistant|tool)\"|\"(?:messages|content|prompt|input_text|input_image|image_url)\"\\s*:\\s*[\\[{\"']/i\nconst CREDENTIAL_BODY_RE =\n  /-----BEGIN (?:RSA |EC |OPENSSH |PRIVATE )?PRIVATE KEY-----|\"type\"\\s*:\\s*\"service_account\"|credentials\\.json|\\.dsh[/\\\\](?:credentials|auth)/i\nconst AUTH_HEADER_RE = /\\b(Authorization|Proxy-Authorization|Cookie|Set-Cookie)\\s*:\\s*[^\\r\\n]*/gi\nconst BEARER_RE = /\\bBearer\\s+[A-Za-z0-9._\\-+=/]{8,}/g\nconst SECRET_FIELD_RE =\n  /([\"']?(?:api[_-]?key|access[_-]?token|refresh[_-]?token|token|bearer|authorization|cookie|set-cookie|nonce|credential|private[_-]?key|password|secret|app[_-]?secret|client[_-]?secret|password|z_c0|d_c0)[\"']?\\s*[:=]\\s*)(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|[^\\s,&;}]+)/gi\nconst SECRET_QUERY_RE =\n  /([?&](?:token|api[_-]?key|key|secret|password|bootstrap|code|sig|signature|credential|password)=)[^\\s&#\"']+/gi\nconst URL_CREDENTIAL_RE = /\\b(https?:\\/\\/)[^\\s/:@]+:[^\\s/@]+@/gi\nconst BOOTSTRAP_RE = /\\/bootstrap\\/[^\\s\"'?&#]+/gi\nconst KNOWN_TOKEN_RE = /\\b(?:sk-[A-Za-z0-9_-]{10,}|gh[pousr]_[A-Za-z0-9_]{16,}|github_pat_[A-Za-z0-9_]{20,}|tvly-[A-Za-z0-9_-]{10,}|AKIA[0-9A-Z]{16})\\b/g\nconst PATH_RE = /(?:[A-Za-z]:\\\\|\\\\\\\\)[^\\s\"'`<>|]+|(?:\\/(?:home|Users|tmp|var|root)\\/|~\\/)[^\\s\"'`<>|]+/g\n\nexport function isPluginLogLevel(value: unknown): value is PluginLogLevel {\n  return typeof value === 'string' && (PLUGIN_LOG_LEVELS as readonly string[]).includes(value)\n}\n\nexport function pluginLogLevelEnabled(level: PluginLogLevel, minimum: PluginLogLevel): boolean {\n  return PLUGIN_LOG_LEVELS.indexOf(level) >= PLUGIN_LOG_LEVELS.indexOf(minimum)\n}\n\nexport function normalizePluginLogSource(raw: string): string {\n  const stripped = String(raw || '').trim().replace(/^@[^/]+\\//, '').toLowerCase()\n    .replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '')\n  const prefixed = /^[a-z]/.test(stripped) ? stripped : `p-${stripped}`\n  const bounded = prefixed.slice(0, 64).replace(/-+$/g, '')\n  return SOURCE_RE.test(bounded) ? bounded : 'dsh-plugin'\n}\n\nexport function normalizePluginLogEvent(raw: string): string {\n  const cleaned = String(raw || '').trim().toLowerCase()\n    .replace(/[^a-z0-9._-]+/g, '-').replace(/^[^a-z]+/, '').slice(0, 128)\n  return EVENT_RE.test(cleaned) ? cleaned : 'plugin.event'\n}\n\n/**\n * Parse a level specification like `debug` or `dsh-zhihu=debug,dsh-dot:warn,info`.\n * Source-specific rules win over a bare fallback level.\n */\nexport function parsePluginLogLevel(\n  spec: string | undefined | null,\n  source?: string,\n  fallback: PluginLogLevel = DEFAULT_PLUGIN_LOG_LEVEL,\n): PluginLogLevel {\n  if (!spec || typeof spec !== 'string') return fallback\n  const normalizedSource = source ? normalizePluginLogSource(source) : undefined\n  let wildcard: PluginLogLevel | undefined\n  for (const token of spec.split(',').map(part => part.trim()).filter(Boolean)) {\n    const lowered = token.toLowerCase()\n    if (isPluginLogLevel(lowered)) {\n      wildcard = lowered\n      continue\n    }\n    const match = /^([^=:]+)[=:]([a-z]+)$/i.exec(token)\n    if (!match) continue\n    const target = match[1]!.trim()\n    const candidate = match[2]!.trim().toLowerCase()\n    if (!isPluginLogLevel(candidate)) continue\n    if (target === '*') {\n      wildcard = candidate\n      continue\n    }\n    if (normalizedSource && normalizePluginLogSource(target) === normalizedSource) {\n      return candidate\n    }\n  }\n  return wildcard ?? fallback\n}\n\nexport function sanitizePluginLogText(text: string, maxChars = PLUGIN_LOG_MAX_MESSAGE_CHARS): string {\n  if (!text) return ''\n  if (CREDENTIAL_BODY_RE.test(text)) return '[omitted credential material]'\n  if (CHAT_PAYLOAD_RE.test(text)) return '[omitted chat payload]'\n  const redacted = text\n    .replace(AUTH_HEADER_RE, '$1: [redacted]')\n    .replace(BEARER_RE, 'Bearer [redacted]')\n    .replace(SECRET_FIELD_RE, (full, prefix: string) => {\n      const value = full.slice(prefix.length)\n      if (value.startsWith('\"')) return `${prefix}\"[redacted]\"`\n      if (value.startsWith(\"'\")) return `${prefix}'[redacted]'`\n      return `${prefix}[redacted]`\n    })\n    .replace(SECRET_QUERY_RE, '$1[redacted]')\n    .replace(URL_CREDENTIAL_RE, '$1[redacted]@')\n    .replace(BOOTSTRAP_RE, '/bootstrap/[redacted]')\n    .replace(KNOWN_TOKEN_RE, '[redacted]')\n    .replace(PATH_RE, '[path]')\n  return truncateLogText(redacted, maxChars)\n}\n\nexport function sanitizePluginLogContext(\n  input: PluginLogContext | undefined,\n): Record<string, PluginLogScalar> | undefined {\n  if (!input) return undefined\n  const output: Record<string, PluginLogScalar> = {}\n  for (const [key, value] of Object.entries(input).slice(0, 32)) {\n    if (value === undefined || !CONTEXT_KEY_RE.test(key)) continue\n    if (typeof value === 'number' && !Number.isFinite(value)) continue\n    if (SECRET_KEY_RE.test(key)) {\n      output[key] = '[redacted]'\n      continue\n    }\n    output[key] = typeof value === 'string' ? sanitizePluginLogText(value, 1_000) : value\n  }\n  if (!Object.keys(output).length) return undefined\n  const encoded = JSON.stringify(output)\n  if (encoded.length <= PLUGIN_LOG_MAX_CONTEXT_CHARS) return output\n  return { omitted: true, reason: 'Diagnostic context exceeded its size limit.' }\n}\n\nexport function sanitizePluginLogError(error: unknown): PluginLogError | undefined {\n  if (error === undefined) return undefined\n  const row = error && typeof error === 'object'\n    ? error as { name?: unknown; message?: unknown; stack?: unknown; code?: unknown }\n    : {}\n  const rawMessage = typeof row.message === 'string' ? row.message : String(error)\n  const result: PluginLogError = {\n    name: typeof row.name === 'string' && row.name.trim() ? sanitizePluginLogText(row.name.trim(), 100) : 'Error',\n    message: sanitizePluginLogText(rawMessage) || 'Unknown error',\n  }\n  if (typeof row.stack === 'string' && row.stack.trim()) {\n    result.stack = sanitizePluginLogText(row.stack, 24_000)\n  }\n  if (typeof row.code === 'string' && /^[A-Za-z0-9_./:-]{1,100}$/.test(row.code)) {\n    result.code = sanitizePluginLogText(row.code, 100)\n  } else if (typeof row.code === 'number' && Number.isFinite(row.code)) {\n    result.code = String(row.code)\n  }\n  return result\n}\n\nexport function mergePluginLogContext(\n  base: PluginLogContext | undefined,\n  extra: PluginLogContext | undefined,\n): PluginLogContext | undefined {\n  if (!base) return extra\n  if (!extra) return base\n  return { ...base, ...extra }\n}\n\nexport function buildPluginLogEntry(\n  input: PluginLogInput,\n  meta: {\n    at: Date\n    source: string\n    surface: 'host' | 'client'\n    profile?: string\n    pid?: number\n    correlation?: PluginLogContext\n  },\n): PluginLogEntry {\n  const entry: PluginLogEntry = {\n    version: 1,\n    at: meta.at.toISOString(),\n    level: isPluginLogLevel(input.level) ? input.level : 'info',\n    source: normalizePluginLogSource(meta.source),\n    surface: meta.surface,\n    ...(meta.profile ? { profile: meta.profile } : {}),\n    event: normalizePluginLogEvent(input.event),\n    message: sanitizePluginLogText(input.message || 'No diagnostic message was provided.', PLUGIN_LOG_MAX_MESSAGE_CHARS),\n    ...(meta.pid !== undefined ? { pid: meta.pid } : {}),\n  }\n  const context = sanitizePluginLogContext(mergePluginLogContext(meta.correlation, input.context))\n  if (context) entry.context = context\n  const error = sanitizePluginLogError(input.error)\n  if (error) entry.error = error\n  return entry\n}\n\nexport function createChildPluginLogger(parent: PluginLogger, bound: PluginLogContext): PluginLogger {\n  return {\n    get source() { return parent.source },\n    get file() { return parent.file },\n    get lastWriteError() { return parent.lastWriteError },\n    debug: (event, message, context) => parent.debug(event, message, mergePluginLogContext(bound, context)),\n    info: (event, message, context) => parent.info(event, message, mergePluginLogContext(bound, context)),\n    warn: (event, message, error, context) => parent.warn(event, message, error, mergePluginLogContext(bound, context)),\n    error: (event, message, error, context) => parent.error(event, message, error, mergePluginLogContext(bound, context)),\n    fault: (event, message, error, context) => parent.fault(event, message, error, mergePluginLogContext(bound, context)),\n    write: input => parent.write({ ...input, context: mergePluginLogContext(bound, input.context) }),\n    child: next => createChildPluginLogger(parent, mergePluginLogContext(bound, next) ?? {}),\n  }\n}\n\nexport function truncateLogText(text: string, maxChars: number): string {\n  if (text.length <= maxChars) return text\n  const marker = '[truncated]\\n'\n  if (maxChars <= marker.length) return text.slice(0, Math.max(0, maxChars))\n  return `${marker}${text.slice(-(maxChars - marker.length))}`\n}\n","import {\n  DEFAULT_PLUGIN_LOG_LEVEL, buildPluginLogEntry, createChildPluginLogger,\n  normalizePluginLogSource, parsePluginLogLevel, pluginLogLevelEnabled,\n  sanitizePluginLogText,\n  type PluginLogContext, type PluginLogEntry, type PluginLogInput,\n  type PluginLogLevel, type PluginLogger,\n} from './log-shared.ts'\n\nexport * from './log-shared.ts'\n\nexport const CLIENT_PLUGIN_LOG_GLOBAL = '__KLARKXY_PLUGIN_LOGS__'\nexport const CLIENT_PLUGIN_LOG_LIMIT = 500\n\nexport interface ClientPluginLoggerOptions {\n  minimumLevel?: PluginLogLevel\n  now?: () => Date\n  bufferLimit?: number\n  forwardToHostLogger?: boolean\n  loadedContext?: PluginLogContext\n}\n\ntype BrowserContextLike = {\n  effect?: (callback: () => () => void, label?: string) => unknown\n  logger?: {\n    warn?: (...args: unknown[]) => void\n    error?: (...args: unknown[]) => void\n  }\n}\n\ntype GlobalLogCarrier = {\n  [CLIENT_PLUGIN_LOG_GLOBAL]?: PluginLogEntry[]\n  window?: { localStorage?: { getItem?: (key: string) => string | null } }\n  console?: {\n    debug?: (...args: unknown[]) => void\n    info?: (...args: unknown[]) => void\n    warn?: (...args: unknown[]) => void\n    error?: (...args: unknown[]) => void\n  }\n}\n\nfunction readStorageFlag(key: string): string | undefined {\n  try {\n    const win = (globalThis as unknown as GlobalLogCarrier).window\n    const storage = win?.localStorage\n    const value = storage?.getItem?.(key)\n    return typeof value === 'string' && value.trim() ? value.trim() : undefined\n  } catch {\n    return undefined\n  }\n}\n\nfunction sharedClientBuffer(limit: number): PluginLogEntry[] {\n  const carrier = globalThis as unknown as GlobalLogCarrier\n  if (!Array.isArray(carrier[CLIENT_PLUGIN_LOG_GLOBAL])) {\n    try {\n      carrier[CLIENT_PLUGIN_LOG_GLOBAL] = []\n    } catch {\n      return []\n    }\n  }\n  const list = carrier[CLIENT_PLUGIN_LOG_GLOBAL]!\n  const overflow = list.length - limit\n  if (overflow > 0) list.splice(0, overflow)\n  return list\n}\n\nexport function readClientPluginLogs(source?: string): PluginLogEntry[] {\n  const carrier = globalThis as unknown as GlobalLogCarrier\n  const list = Array.isArray(carrier[CLIENT_PLUGIN_LOG_GLOBAL]) ? carrier[CLIENT_PLUGIN_LOG_GLOBAL]! : []\n  if (!source) return list.slice()\n  const normalized = normalizePluginLogSource(source)\n  return list.filter(entry => entry.source === normalized)\n}\n\nexport function clearClientPluginLogs(): void {\n  const carrier = globalThis as unknown as GlobalLogCarrier\n  if (Array.isArray(carrier[CLIENT_PLUGIN_LOG_GLOBAL])) {\n    carrier[CLIENT_PLUGIN_LOG_GLOBAL]!.length = 0\n  }\n}\n\nexport function createClientPluginLogger(\n  source: string,\n  ctx?: unknown,\n  options: ClientPluginLoggerOptions = {},\n): PluginLogger {\n  const normalized = normalizePluginLogSource(source)\n  const now = options.now ?? (() => new Date())\n  const limit = Math.max(10, options.bufferLimit ?? CLIENT_PLUGIN_LOG_LIMIT)\n  const browserCtx = ctx && typeof ctx === 'object' ? ctx as BrowserContextLike : undefined\n\n  const resolveMinimum = (): PluginLogLevel => {\n    if (options.minimumLevel) return options.minimumLevel\n    return parsePluginLogLevel(readStorageFlag('dsh-plugin-log-level'), normalized, DEFAULT_PLUGIN_LOG_LEVEL)\n  }\n\n  const logger: PluginLogger = {\n    source: normalized,\n    file: null,\n    lastWriteError: null,\n    debug: (event, message, context) => logger.write({ level: 'debug', event, message, ...(context ? { context } : {}) }),\n    info: (event, message, context) => logger.write({ level: 'info', event, message, ...(context ? { context } : {}) }),\n    warn: (event, message, error, context) => logger.write({\n      level: 'warn', event, message,\n      ...(error !== undefined ? { error } : {}),\n      ...(context ? { context } : {}),\n    }),\n    error: (event, message, error, context) => logger.write({\n      level: 'error', event, message,\n      ...(error !== undefined ? { error } : {}),\n      ...(context ? { context } : {}),\n    }),\n    fault: (event, message, error, context) => logger.write({\n      level: 'fault', event, message,\n      ...(error !== undefined ? { error } : {}),\n      ...(context ? { context } : {}),\n    }),\n    child: context => createChildPluginLogger(logger, context),\n    write(input: PluginLogInput): boolean {\n      try {\n        if (!pluginLogLevelEnabled(input.level, resolveMinimum())) return false\n        const entry = buildPluginLogEntry(input, {\n          at: now(),\n          source: normalized,\n          surface: 'client',\n        })\n        const buffer = sharedClientBuffer(limit)\n        buffer.push(entry)\n        const overflow = buffer.length - limit\n        if (overflow > 0) buffer.splice(0, overflow)\n\n        if (options.forwardToHostLogger !== false && browserCtx?.logger) {\n          const summary = sanitizePluginLogText(`${normalized} [${entry.event}]: ${entry.message}`, 500)\n          if (entry.level === 'warn' && typeof browserCtx.logger.warn === 'function') {\n            browserCtx.logger.warn(summary)\n          } else if ((entry.level === 'error' || entry.level === 'fault') && typeof browserCtx.logger.error === 'function') {\n            browserCtx.logger.error(summary)\n          }\n        }\n        if (readStorageFlag('dsh-plugin-log-console') === '1') {\n          const con = (globalThis as unknown as GlobalLogCarrier).console\n          const fn = entry.level === 'debug' ? con?.debug\n            : entry.level === 'info' ? con?.info\n              : entry.level === 'warn' ? con?.warn\n                : con?.error\n          fn?.call(con, `[${normalized}] ${entry.event}: ${entry.message}`, entry)\n        }\n        return true\n      } catch {\n        return false\n      }\n    },\n  }\n  return logger\n}\n\nexport function installClientPluginLogger(\n  ctx: unknown,\n  source: string,\n  options: ClientPluginLoggerOptions = {},\n): PluginLogger {\n  const logger = createClientPluginLogger(source, ctx, options)\n  logger.info('client.loaded', 'Client plugin initialized.', options.loadedContext)\n  const browserCtx = ctx && typeof ctx === 'object' ? ctx as BrowserContextLike : undefined\n  if (typeof browserCtx?.effect === 'function') {\n    try {\n      browserCtx.effect(() => () => {\n        logger.debug('client.disposed', 'Client plugin disposed.')\n      }, `${logger.source}.client-logger`)\n    } catch {\n      // Non-Cordis mock context.\n    }\n  }\n  return logger\n}\n\nexport async function clientLogStep<T>(\n  logger: PluginLogger,\n  step: string,\n  context: PluginLogContext | undefined,\n  action: () => Promise<T>,\n  completedLevel: PluginLogLevel = 'debug',\n): Promise<T> {\n  const started = Date.now()\n  const base = { ...context, step }\n  logger.debug('step.started', 'Client step started.', base)\n  try {\n    const result = await action()\n    logger.write({\n      level: completedLevel,\n      event: 'step.completed',\n      message: 'Client step completed.',\n      context: { ...base, durationMs: Date.now() - started },\n    })\n    return result\n  } catch (error) {\n    logger.error('step.failed', 'Client step failed.', error, {\n      ...base,\n      durationMs: Date.now() - started,\n    })\n    throw error\n  }\n}\n","import type { RpcResult as SharedRpcResult } from '@klarkxy/dsh-plugin-kit/contracts'\nexport type RpcResult<T = unknown> = SharedRpcResult<T>\nexport const PLUGIN_NAME = '@klarkxy/dsh-deep-view'\nexport const RPC_CHANNEL = '/dsh-deep-view'\nexport const VIEW_OWNER = 'dsh-deep-view'\nexport const HOST_SERVICE = 'dshDeepView'\nexport type DeepViewHost = {\n  /** Move an open card and route stale session lookups to a replacement root session. */\n  handoffSession(fromSessionId: string, toSessionId: string): boolean\n}\n\nexport type Scalar = string | number | boolean\nexport type Formula = { '=': string }\nexport type Value = Scalar | Formula\nexport type ChoiceOption = { label: string; value?: Scalar }\nexport type StepStatus = 'done' | 'active' | 'pending' | 'blocked'\nexport type SourceItem = { label: string; url: string }\nexport type StepItem = { label: string; detail?: Value; status?: Value }\nexport type FormField = { id: string; label: string; placeholder?: string; value?: string; multiline?: boolean; readOnly?: boolean }\nexport type MathPoint = { id: string; label?: string; x: number; y: number; constrain?: 'free' | 'horizontal' | 'vertical' }\nexport type MathCurve = { label?: string; expression: string }\nexport type FlowNode = { id: string; label: string; detail?: string; x: number; y: number; tone?: 'neutral' | 'accent' | 'success' | 'warn' | 'bad' }\nexport type FlowEdge = { id: string; source: string; target: string; label?: string }\nexport type ExploreDatum = Record<string, Scalar>\nexport type MapLocation = { id: string; label: string; detail?: string; coordinates: [number, number] }\nexport type MapRoute = { label?: string; coordinates: [number, number][] }\nexport type ViewBinding = { id: string; value: unknown; kind?: 'input' | 'math' | 'flow' | 'explore' | 'map'; node?: ViewNode }\n// The wire shares `items` between sources ({label,url}) and steps\n// ({label,detail?,status?}); the validator enforces the shape per node type.\n// Narrow with `isSourceItem`/`isStepItem` before reading `url` or `status`.\nexport function isSourceItem(item: SourceItem | StepItem): item is SourceItem {\n  return item !== null && typeof item === 'object' && 'url' in item\n}\nexport function isStepItem(item: SourceItem | StepItem): item is StepItem {\n  return item !== null && typeof item === 'object' && !('url' in item)\n}\nexport type ViewNode = {\n  type: 'stack' | 'row' | 'text' | 'metric' | 'table' | 'chart' | 'progress' | 'callout' | 'sources' | 'steps'\n    | 'slider' | 'number' | 'choice' | 'toggle' | 'options' | 'confirm' | 'form' | 'submit'\n    | 'math' | 'flow' | 'explore' | 'map'\n  id?: string\n  children?: ViewNode[]\n  let?: Record<string, string>\n  text?: Value\n  label?: string\n  value?: Value\n  tone?: Value\n  caption?: Value\n  columns?: { key: string; label: string }[]\n  rows?: Value[][]\n  kind?: 'bar' | 'hbar' | 'line' | 'area' | 'donut'\n  categories?: Scalar[]\n  series?: { name?: string; values: (number | Formula)[] }[]\n  unit?: string\n  percent?: Value\n  max?: Value\n  valueLabel?: Value\n  items?: SourceItem[] | StepItem[]\n  min?: number\n  step?: number\n  options?: ChoiceOption[] | { label: string; description?: string }[]\n  multi?: boolean\n  confirmLabel?: string\n  cancelLabel?: string\n  fields?: FormField[]\n  submitLabel?: string\n  /** Interactive math: point ids expose `<id>X` and `<id>Y` bindings. */\n  mathPoints?: MathPoint[]\n  curves?: MathCurve[]\n  domain?: [number, number]\n  range?: [number, number]\n  /** Node graph: id receives the selected node id. */\n  nodes?: FlowNode[]\n  edges?: FlowEdge[]\n  /** Bounded data exploration: id receives selected category values or an x/y interval. */\n  data?: ExploreDatum[]\n  xKey?: string\n  yKey?: string\n  colorKey?: string\n  select?: 'point' | 'interval'\n  /** Map: id receives the selected location id. */\n  center?: [number, number]\n  zoom?: number\n  locations?: MapLocation[]\n  routes?: MapRoute[]\n}\nexport type ShownView = { title: string; view: ViewNode; interactive: boolean; revision?: number }\nexport type ViewFailure = { error: string }\nexport type ViewSnapshot = ShownView & { id: string; sessionId: string; callId?: string; revision: number }\nexport type PendingView = ViewSnapshot\nexport type ViewAnswer = { id: string; action: string; values: Record<string, unknown>; revision?: number }\n/** Stored on the same user message as its readable answer, outside model text. */\nexport type ViewAnswerMetadata = { owner: typeof VIEW_OWNER; version: 1; answer: ViewAnswer }\nexport type ViewPresentation = {\n  owner: typeof VIEW_OWNER\n  viewId?: string\n  title: string\n  view: ViewNode\n  interactive: boolean\n  awaitReply: boolean\n  revision?: number\n}\nexport function isRecord(value: unknown): value is Record<string, unknown> {\n  return value !== null && typeof value === 'object' && !Array.isArray(value)\n}\n","// Migrated from deep-view/src/react/ui.js (Apache-2.0).\n// Small, host-neutral labels and SVG controls; no private color tokens.\nimport type { ReactNode } from 'react'\nexport type ViewT = (key: string, params?: Record<string, unknown>) => string\nexport const english: ViewT = (key, params) => key.replace(/\\{(\\w+)\\}/g, (_, name) => String(params?.[name] ?? `{${name}}`))\n\nexport function LineIcon({ paths }: { paths: string[] }) {\n  return <svg width=\"15\" height=\"15\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLine