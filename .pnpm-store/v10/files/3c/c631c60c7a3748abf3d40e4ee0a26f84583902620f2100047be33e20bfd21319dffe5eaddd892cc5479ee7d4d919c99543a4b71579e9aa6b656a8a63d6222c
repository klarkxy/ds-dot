\n  return lines.join('\\n')\n}\n\n/** Legacy messages have no metadata. Restore only unambiguous, fully validated\n * answers that reproduce the exact text written by this plugin. Never guess\n * from ordinary prose, and never modify the stored message. */\nexport function legacyAnswer(card: Card, text: string): ViewAnswer | null {\n  if (text.startsWith('{')) {\n    try {\n      const data: unknown = JSON.parse(text)\n      if (!isRecord(data) || data.kind !== 'answer_to_pending_view' || data.tool !== 'show_view' || !Array.isArray(data.answers)) return null\n      const answer = data.answers.find(value => isRecord(value) && value.id === card.id)\n      if (!isRecord(answer) || typeof answer.action !== 'string') return null\n      const values = validateViewAnswer(card.view, answer.action, answer.values)\n      return values.error === undefined ? { id: card.id, action: answer.action, values } : null\n    } catch { return null }\n  }\n  const lines = text.split('\\n')\n  if (lines.shift() !== (card.title || 'Deep View')) return null\n  const candidates: ViewAnswer[] = []\n  for (const node of controls(card.view)) {\n    const rest = [...lines]\n    const values: Record<string, unknown> = {}\n    if (node.type === 'options') {\n      const line = rest.shift()\n      if (line === undefined) continue\n      const labels = node.options?.map(option => option.label) ?? []\n      if (node.multi && labels.some(label => label.includes(', '))) continue\n      values.selected = node.multi ? line.split(', ') : [line]\n    } else if (node.type === 'confirm') {\n      const line = rest.shift(), yes = node.confirmLabel ?? 'Confirm', no = node.cancelLabel ?? 'Cancel'\n      if (yes === no || line !== yes && line !== no) continue\n      values.confirmed = line === yes\n    } else if (node.type === 'form') {\n      if (rest[0] !== undefined && rest[0] === (node.cancelLabel ?? 'Cancel')) {\n        rest.shift()\n        values.canceled = true\n      } else {\n        const fields: Record<string, string> = {}\n        let valid = true\n        const declared = node.fields ?? []\n        const inputs = viewInputs(card.view) as ViewNode[]\n        const inputPrefix = inputs[0] ? `${inputs[0].label || inputs[0].id}=` : undefined\n        const boundary = (line: string | undefined) => line !== undefined && (declared.some(field => line.startsWith(`${field.label}: `)) || (inputPrefix !== undefined && line.startsWith(inputPrefix)))\n        for (let index = 0; index < declared.length; index++) {\n          const field = declared[index], prefix = `${field.label}: `\n          if (rest[0] === undefined || !rest[0].startsWith(prefix)) { valid = false; break }\n          const value = [rest.shift()!.slice(prefix.length)]\n          // Only a field declared as multiline may consume continuation lines.\n          // Otherwise a malformed ordinary message must not be guessed as an answer.\n          if (field.multiline === true) while (rest[0] !== undefined && !boundary(rest[0])) value.push(rest.shift()!)\n          fields[field.id] = value.join('\\n')\n        }\n        if (!valid) continue\n        values.fields = fields\n      }\n    }\n    const inputs = viewInputs(card.view) as ViewNode[]\n    if (inputs.length) {\n      const pairs = rest.shift()?.split('; ')\n      if (!pairs || pairs.length !== inputs.length) continue\n      const sent: Record<string, unknown> = {}\n      let valid = true\n      for (let i = 0; i < inputs.length; i++) {\n        const input = inputs[i], prefix = `${input.label || input.id}=`\n        if (!pairs[i].startsWith(prefix)) { valid = false; break }\n        const value = pairs[i].slice(prefix.length)\n        if (input.type === 'toggle') sent[input.id!] = value === 'on' ? true : value === 'off' ? false : undefined\n        else if (input.type === 'choice') {\n          const choices = input.options?.filter(option => option.label === value) ?? []\n          sent[input.id!] = choices.length === 1 ? choiceValue(choices[0]) : undefined\n        } else {\n          const unit = input.unit ? ` ${input.unit}` : ''\n          sent[input.id!] = !unit || value.endsWith(unit) ? Number(unit ? value.slice(0, -unit.length) : value) : undefined\n        }\n      }\n      if (!valid) continue\n      values.inputs = sent\n    }\n    if (node.type === 'submit' && rest.shift() !== (node.label ?? 'Submit')) continue\n    if (rest.length || !node.id) continue\n    const checked = validateViewAnswer(card.view, node.id, values)\n    if (checked.error === undefined && answerText(card, node.id, checked) === text) {\n      candidates.push({ id: card.id, action: node.id, values: checked })\n    }\n  }\n  return candidates.length === 1 ? candidates[0] : null\n}\n","import { checkShownView, validateViewAnswer } from './core/index.js'\nimport { isRecord, VIEW_OWNER, type ViewAnswer, type ViewNode } from './contracts.ts'\nimport type { ReplySnapshot, ToolViewBlock } from './runtime.ts'\nimport { legacyAnswer } from './answer-text.ts'\n\n/** Read visible, durable user/steering messages only, including inherited history. */\nexport function replyAnswers(snapshot: ReplySnapshot): ReadonlyMap<string, ViewAnswer> {\n  const answers = new Map<string, ViewAnswer>()\n  type Card = { id: string; title: string; view: ViewNode; revision: number }\n  // Cards with the same viewId are immutable revisions of one view. Only the\n  // newest snapshot can still be answered, so merge to the latest revision\n  // instead of letting two revisions compete over one composer message.\n  let cards = new Map<string, Card>()\n  const collect = (block: ToolViewBlock) => {\n    const meta = block.meta\n    if (block.kind === 'tool-result' && !block.isError && isRecord(meta) && meta.owner === VIEW_OWNER && meta.awaitReply === true && typeof meta.viewId === 'string') {\n      const shown = checkShownView(meta.title, meta.view)\n      if (!('error' in shown)) {\n        const revision = typeof meta.revision === 'number' && Number.isSafeInteger(meta.revision) && meta.revision > 0 ? meta.revision : 1\n        if (revision >= (cards.get(meta.viewId)?.revision ?? 0)) cards.set(meta.viewId, { id: meta.viewId, title: shown.title, view: shown.view, revision })\n      }\n    }\n    for (const child of block.subCalls ?? []) collect(child)\n  }\n  for (const key of snapshot.order) {\n    const node = snapshot.nodes.get(key)\n    if (node?.kind === 'tool-call' && node.data?.root) collect(node.data.root)\n    if (node?.kind !== 'user' && node?.kind !== 'steering') continue\n    const source = node.data?.source\n    if (!isRecord(source) || source.kind !== 'user') continue\n    // Only the very next human message can answer an old card, and it must\n    // match exactly one card. Ambiguous/edited legacy text remains a preview.\n    if (source.deepView === undefined) {\n      const text = node.data?.content?.filter(isRecord).filter(block => block.type === 'text').map(block => block.text).join('') ?? ''\n      const candidates = [...cards.values()].map(card => ({ card, answer: legacyAnswer(card, text) }))\n        .filter((candidate): candidate is { card: Card; answer: ViewAnswer } => candidate.answer !== null)\n      if (candidates.length === 1 && !answers.has(candidates[0].answer.id)) {\n        const [{ card, answer }] = candidates\n        answers.set(card.id, { ...answer, revision: card.revision })\n      }\n    }\n    cards = new Map()\n    if (!isRecord(source.deepView)) continue\n    const meta = source.deepView\n    if (meta.owner !== VIEW_OWNER || meta.version !== 1 || !isRecord(meta.answer)) continue\n    const answer = meta.answer\n    if (typeof answer.id !== 'string' || typeof answer.action !== 'string' || !isRecord(answer.values)) continue\n    // The first accepted reply settles a card; later inputs cannot change it.\n    if (!answers.has(answer.id)) answers.set(answer.id, answer as ViewAnswer)\n  }\n  return answers\n}\n\nexport function checkedAnswer(answer: ViewAnswer | undefined, id: string | undefined, view: ViewNode, revision?: number): ViewAnswer | null {\n  if (!answer || !id || answer.id !== id || revision !== undefined && (answer.revision ?? 1) !== revision) return null\n  const values = validateViewAnswer(view, answer.action, answer.values)\n  return values.error === undefined ? { id, action: answer.action, values, ...(answer.revision !== undefined ? { revision: answer.revision } : {}) } : null\n}\n\nexport function sameAnswers(left: ReadonlyMap<string, ViewAnswer>, right: ReadonlyMap<string, ViewAnswer>): boolean {\n  return left.size === right.size && [...left].every(([id, answer]) => {\n    const next = right.get(id)\n    return next === answer || next?.action === answer.action && (next.revision ?? 1) === (answer.revision ?? 1)\n      && JSON.stringify(next.values) === JSON.stringify(answer.values)\n  })\n}\n","export const uiZh = {\n  copy: '复制', copied: '已复制', footnotes: '脚注', code: '代码', wrap: '自动换行', unwrap: '不换行',\n  prepared: '界面已显示', preparing: '正在组织界面…', error: '界面未能显示', invalid: '界面数据无效',\n  local: '这是已结束的界面；需要调整时请继续对话。', answerFailed: '回答未能发送，请重试。',\n  building: '正在组织界面…', invalidCode: '查看原始界面描述',\n  chart: '图表', chartOptions: '图表选项', viewAsChart: '查看图表', viewAsTable: '查看表格', copyData: '复制数据',\n  chartNumber: '图表 {n}', value: '值', series: '系列', view: '视图', sources: '来源', progress: '进度', yourAnswer: '你的回答',\n  options: '选项', submit: '提交', cancel: '取消', confirm: '确认', send: '发送', selected: '已选择',\n  sending: '正在发送…', filling: '正在填入输入框…', filled: '已填入输入框，请检查后发送', fillFailed: '未能填入输入框，请检查当前草稿状态',\n  fillDraft: '填入输入框', waitingDock: '请在输入框上方的卡片中回答。', expired: '这张卡片已过期，请让模型重新生成。', dismissFailed: '关闭失败，请重试。', dismissView: '关闭视图', draftConflict: '输入框已有草稿，请选择填入方式', replaceDraft: '替换草稿', appendDraft: '保留并追加',\n  steps: '步骤',\n  nodeGraph: '节点关系图', selectNode: '请选择一个节点',\n  nothingToExplore: '没有可探索的数据', selectedValues: '已选择 {n} 项：{values}',\n  explorePointHint: '点击数据点进行选择；双击清除', exploreIntervalHint: '拖动选择范围；双击清除',\n  exploreFailed: '图表未能绘制。', dataRows: '