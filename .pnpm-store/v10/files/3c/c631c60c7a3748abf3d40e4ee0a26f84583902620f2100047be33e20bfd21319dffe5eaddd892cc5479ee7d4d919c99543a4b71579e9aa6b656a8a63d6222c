er')}</ActionButton> : null}\n    </div>\n  </form>\n}\n// A settled form keeps a receipt line, not a second frozen copy of the fields.\n// The full values already live in the user message's answer text.\nfunction SettledForm({ node, answer, t }: { node: ViewNode; answer?: Answer | null; t: ViewT }) {\n  const sent = answerValues(answer, node)\n  if (sent === undefined) return <div className=\"dvui-form\">{fieldsOf(node).map(field => <div className=\"dvui-field\" key={field.id}>\n    <span className=\"dvui-field-label\">{field.label}</span><span className=\"dvui-option-desc\">{field.value || field.placeholder || ''}</span>\n  </div>)}</div>\n  const label = sent.canceled === true ? (node.cancelLabel ?? t('Cancel')) : (node.submitLabel ?? t('Submit'))\n  return <div className=\"dvui-actions\"><span className=\"dvui-badge\">{label}</span></div>\n}\nfunction WidgetTable({ node, lookup }: { node: ViewNode; lookup: (name: string) => unknown }) {\n  const columns = Array.isArray(node.columns) ? node.columns : []\n  const rows = (Array.isArray(node.rows) ? node.rows : []).map(row => (Array.isArray(row) ? row : []).map(cell => resolve(cell, lookup, '')))\n  const numeric = columns.map((_, index) => {\n    const cells = rows.map(row => row[index]).filter(cell => cell !== undefined && cell !== '')\n    return cells.length > 0 && cells.every(cell => typeof cell === 'number' || (typeof cell === 'string' && NUMERIC_CELL.test(cell.trim())))\n  })\n  return <div className=\"dvui-table\"><table><thead><tr>{columns.map((column, index) => <th key={column.key ?? index} scope=\"col\" className={numeric[index] ? 'dvui-num' : undefined}>{column.label}</th>)}</tr></thead><tbody>{rows.map((row, rowIndex) => <tr key={rowIndex}>{columns.map((column, index) => <td key={column.key ?? index} className={numeric[index] ? 'dvui-num' : undefined}>{cellText(row[index])}</td>)}</tr>)}</tbody></table></div>\n}\nfunction WidgetProgress({ node, lookup, t }: { node: ViewNode; lookup: (name: string) => un