e model groups (pure data; no React). */\nexport interface ModelPickerLeadingItem {\n  readonly id: string\n  readonly label: string\n  readonly selected?: boolean\n}\n\n/** Status banner data the picker renders inside the menu header, above the groups. */\nexport interface ModelPickerStatus {\n  /** Whole-request failure text; renders with a retry action. */\n  readonly error?: string | null\n  /** Advisory row (e.g. the saved route left the catalog); rendered warn-toned, no retry. */\n  readonly warning?: string\n  /** Whether the owner is loading or selecting (dims the banner). */\n  readonly busy?: boolean\n  /** Provider-local failures; still usable groups stay selectable. */\n  readonly failures?: readonly ModelCatalogFailure[]\n  /** Reload action the banner's retry buttons call. */\n  readonly retry?: () => void\n}\n\n/**\n * Occurrence input (`renderFactorySlot` `props`). Everything here is data or\n * callbacks — React content travels through the `anchor` local slot instead.\n */\nexport interface ModelPickerProps {\n  /** Active UI language; `'zh*'` selects the built-in Chinese copy. */\n  readonly locale?: string\n  /** Flat catalog choices (grouped internally by provider). */\n  readonly choices: readonly ModelMenuChoice[]\n  /** Current selection highlight. */\n  readonly selected?: { readonly provider: string; readonly model: string }\n  /** Model pick; the picker closes after the callback runs. */\n  readonly onPick: (route: { provider: string; model: string }) => void\n  /** Extra rows above the model groups (e.g. a \"follow default\" row). */\n  readonly leading?: readonly ModelPickerLeadingItem[]\n  /** Leading-row pick; `undefined` keeps the menu open. */\n  readonly onPickLeading?: (id: string) => void\n  /** Declared reasoning-effort rows; the slider is hidden while empty. */\n  readonly efforts?: ReadonlyArray<{ id: string; name: string }>\n  /** Current effort id; `''`/undefined marks the provider-default row. */\n  readonly selectedEffort?: string\n  /** Effort pick; the menu stays open. `undefined` = provider default. */\n  readonly onPickEffort?: (effort: string | undefined) => void\n  /** Disables the trigger and every menu action. */\n  readonly disabled?: boolean\n  /** Trigger caption; the default anchor falls back to localized \"Select model\". */\n  readonly triggerLabel?: string\n  /** Current effort caption shown after the trigger label (\"model · high\"). */\n  readonly triggerEffortLabel?: string\n  /** Extra class on the default trigger button. */\n  readonly triggerClassName?: string\n  /** Show a spinner instead of the chevron while a selection settles. */\n  readonly busy?: boolean\n  /** Extra class on the portaled menu card. */\n  readonly listClassName?: string\n  /** Menu opens on the searchable model pane ('model') or the root cells. */\n  readonly initialPane?: 'root' | 'model'\n  /** Show the search row even for a small catalog. */\n  readonly alwaysShowSearch?: boolean\n  /** Show the reasoning-effort slider under the model list (default true here). */\n  readonly reasoningSlider?: boolean\n  /** Status banner rendered inside the menu header (load failures, retry). */\n  readonly status?: ModelPickerStatus\n  /** Menu open-state changes; the owner may react (e.g. refresh the catalog). */\n  readonly onOpenChange?: (open: boolean) => void\n  /** Copy overrides; every key is optional. */\n  readonly modelLabel?: string\n  readonly modelValue?: string\n  readonly effortLabel?: string\n  readonly defaultEffortLabel?: string\n  readonly searchPlaceholder?: string\n  readonly emptyLabel?: string\n  readonly clearSearchLabel?: string\n  readonly retryLabel?: string\n}\n\n/** Props one `anchor` local component receives (plus the framework kit). */\nexport interface ModelPickerAnchorProps {\n  /** Mirror of `aria-expanded`; true while the menu is open. */\n  readonly open: boolean\n  /** Disabled state passed down by the owner. */\n  readonly disabled: boolean\n  /** Whether a selection is settling; the default anchor shows a spinner. */\n  readonly busy: boolean\n  /** Resolved trigger caption. */\n  readonly label: string\n  /** Resolved effort caption appended to the caption, if any. */\n  readonly effortLabel?: string\n  /** Extra class on the trigger element. */\n  readonly className?: string\n  /** Anchored-popup marker the picker stamps on the trigger (always 'menu'). */\n  readonly 'aria-haspopup'?: 'menu'\n  /** Mirror of `open`, for ARIA-compliant custom anchors. */\n  readonly 'aria-expanded'?: boolean\n  /** Menu element id while the menu is mounted. */\n  readonly 'aria-controls'?: string\n  /** Resolved accessible name for the trigger. */\n  readonly 'aria-label'?: string\n  /** Set when the picker is disabled; custom anchors may read it instead of `disabled`. */\n  readonly 'aria-disabled'?: boolean\n}\n\ndeclare module '@deepseek-ai/dsh-client-ui-slots' {\n  interface SlotFactoryMap {\n    /**\n     * Reusable model picker: one searchable provider-grouped model list plus an\n     * optional reasoning-effort slider. Consumers call `renderFactorySlot` with\n     * `ModelPickerProps`; `options.slots.anchor` may supply a custom trigger\n     * component typed `ModelPickerAnchorProps`, and `options.fallback` is the\n     * menu rendered while no `klarkxy.model-picker` definition is registered.\n     */\n    'klarkxy.model-picker': {\n      scope: 'root'\n      props: ModelPickerProps\n      /** Occurrence inject face: the active-locale observable bound as a hook. */\n      inject: { hooks: { activeLocale: HostObservable<{ active: string }> } }\n      slots: {\n        anchor: {\n          scope: 'root'\n          props: ModelPickerAnchorProps\n        }\n      }\n      locale: 'model-picker'\n    }\n  }\n  interface LocaleNamespaceMap {\n    /** Copy owned by @klarkxy/dsh-model-picker. */\n    'model-picker':\n      | 'trigger.fallback' | 'trigger.aria' | 'trigger.ariaEffort'\n      | 'menu.model' | 'menu.effort' | 'effort.providerDefault'\n      | 'search.placeholder' | 'search.clear' | 'search.empty' | 'empty.models'\n      | 'status.loading' | 'error.action' | 'action.retry' | 'warning.unroutable'\n  }\n}\n","/**\n * Effort preference — a small client-side memory for explicit reasoning-effort\n * picks, keyed by provider+model route.\n *\n * Why it exists: the Host already persists the complete default selection —\n * `sessionController.selectModel` records the Session selection and calls\n * `ctx.agentDefaultModel.saveSelection(selected)` in the background, and the\n * `agentDefaultModel` Config carries `provider`, `model` and an optional\n * `reasoningEffort` field. A Session with no recorded selection follows that\n * saved default through live `AgentOptions` accessors\n * (`dsh-api-session-controller/agent.js` `agentOptions()`), so a new Session\n * inherits the effort only while the default keeps it.\n *\n * The gap is a model switch: the picker's pick submits provider+model only\n * (native semantics — the adapter resolves its own default effort), which\n * makes `saveSelection` write a config WITHOUT `reasoningEffort`; the default\n * effort is erased and the next new Session loses it. Remembering the last\n * successful explicit effort per route and re-attaching it to later model\n * picks restores \"new Session inherits the last human setting\" without\n * touching Host code, Host events, or existing Sessions — the memory only\n * shapes what THIS surface submits.\n *\n * Rules (matching the Host contract):\n * - Only successful explicit picks are remembered. A failed `select` must\n *   never update memory — nothing was recorded or saved.\n * - Choosing \"Default\" (effort `undefined`) clears the route's entry; the\n *   model then follows the adapter default, never a forced prior pick.\n * - A remembered effort is re-applied only when the catalog declares it for\n *   that exact route: a model that advertises no `efforts` never receives an\n *   explicit effort, so \"不支援 High 的模型不會收到 High\".\n * - No persistence to disk and no Host calls: the memory lasts for the page\n *   lifetime; across reloads the Host's own saved default already carries\n *   the effort forward.\n * - Reads never mutate; this module never triggers an LLM call and never\n *   touches subagent model choices.\n */\n\n/** One selectable route. */\nexport interface EffortRoute {\n  provider: string\n  model: string\n}\n\n/** A selection request: the same shape `directory.select` accepts. */\nexport interface EffortSelection extends EffortRoute {\n  reasoningEffort?: string\n}\n\n/** The subset of catalog metadata the memory validates against. */\nexport interface RouteReasoning {\n  /** Effort ids the model declares (`model.reasoning.efforts[].id`). */\n  efforts?: readonly string[]\n}\n\n/** Normalized select result: `{ ok: true }` or `{ ok: false }`. */\nexport type SelectResult = { ok: boolean; error?: unknown } | undefined\n\ntype SelectFn = (selection: EffortSelection) => Promise<SelectResult> | SelectResult\n\nconst keyOf = (route: EffortRoute): string => JSON.stringify([route.provider, route.model])\n\n/**\n * In-memory per-route effort memory. One instance is shared by the composer\n * seat and any face that submits through `submit`, so a slider pick made in\n * one surface is what the next model pick re-attaches.\n */\nexport class EffortPreference {\n  /** route key → remembered explicit effort (a cleared route has no entry). */\n  private readonly efforts = new Map<string, string>()\n\n  /** The remembered explicit effort for one route, or undefined. */\n  effortFor(route: EffortRoute): string | undefined {\n    return this.efforts.get(keyOf(route))\n  }\n\n  /**\n   * Record one confirmed pick. `undefined` clears the route's entry —\n   * \"Default\" is an explicit choice too, and must not be overridden later.\n   * Callers invoke this only after the Host accepted the selection.\n   */\n  remember(route: EffortRoute, effort: string | undefined): void {\n    const key = keyOf(route)\n    if (effort === undefined) this.efforts.delete(key)\n    else this.efforts.set(key, effort)\n  }\n\n  /**\n   * Effort to attach to a fresh pick of `route`: the remembered value when\n   * the catalog still declares it for that route, else undefined (the pick\n   * then follows the adapter default). Validation is per-route — a model\n   * without declared efforts can never inherit an effort remembered for it.\n   */\n  resolve(route: EffortRoute, reasoning: RouteReasoning | undefined): string | undefined {\n    const effort = this.efforts.get(keyOf(route))\n    if (effort === undefined) return undefined\n    return reasoning?.efforts?.includes(effort) ? effort : undefined\n  }\n\n  /**\n   * Submit helper for a MODEL pick: merge the remembered effort into\n   * `selection` when no effort is already present and the target route still\n   * supports it, call `select`, and remember the resolved effort only on\n   * success. On failure memory is untouched and the result is returned\n   * verbatim.\n   *\n   * This is NOT the right verb for the slider's \"Default\" row: a caller\n   * clearing an effort must submit through `select` directly and call\n   * `remember(route, undefined)` only after success — routing the clear\n   * through `submit` would just re-attach the remembered effort.\n   */\n  async submit(\n    selection: EffortSelection,\n    reasoning: RouteReasoning | undefined,\n    select: SelectFn,\n  ): Promise<SelectResult> {\n    const effort = selection.reasoningEffort ?? this.resolve(selection, reasoning)\n    const intent: EffortSelection = effort === undefined ? { provider: selection.provider, model: selection.model } : { ...selection, reasoningEffort: effort }\n    const result = await select(intent)\n    /* Only a confirmed `ok: true` updates memory. `undefined` is NOT success:\n     * the seat's fallback select resolves undefined for an unavailable\n     * directory, and recording a pick the Host never saw would invent a\n     * preference. */\n    if (result?.ok !== true) return result\n    this.remember(intent, intent.reasoningEffort)\n    return result\n  }\n}\n","export type PluginLogLevel = 'debug' | 'info' | 'warn' | 'error' | 'fault'\n\nexport const PLUGIN_LOG_LEVELS: readonly PluginLogLevel[] = ['debug', 'info', 'warn', 'error', 'fault']\nexport const DEFAULT_PLUGIN_LOG_LEVEL: PluginLogLevel = 'info'\nexport const PLUGIN_LOG_MAX_MESSAGE_CHARS = 16_000\nexport const PLUGIN_LOG_MAX_CONTEXT_CHARS = 8_000\n\nexport type PluginLogScalar = string | number | boolean | null\nexport type PluginLogContext = Record<string, PluginLogScalar | undefined>\n\nexport interface PluginLogInput {\n  level: PluginLogLevel\n  event: string\n  message: string\n  context?: PluginLogContext\n  error?: unknown\n}\n\nexport interface PluginLogError {\n  name: string\n  message: string\n  stack?: string\n  code?: string\n}\n\nexport interface PluginLogEntry {\n  version: 1\n  at: string\n  level: PluginLogLevel\n  source: string\n  surface: 'host' | 'client'\n  profile?: string\n  event: string\n  message: string\n  pid?: number\n  context?: Record<string, PluginLogScalar>\n  error?: PluginLogError\n}\n\nexport interface PluginLogger {\n  readonly source: string\n  readonly file: string | null\n  readonly lastWriteError: string | null\n  debug(event: string, message: string, context?: PluginLogContext): boolean\n  info(event: string, message: string, context?: PluginLogContext): boolean\n  warn(event: string, message: string, error?: unknown, context?: PluginLogContext): boolean\n  error(event: string, message: string, error?: unknown, context?: PluginLogContext): boolean\n  fault(event: string, message: string, error?: unknown, context?: PluginLogContext): boolean\n  write(input: PluginLogInput): boolean\n  child(context: PluginLogContext): PluginLogger\n}\n\nconst SOURCE_RE = /^[a-z][a-z0-9-]{0,63}$/\nconst EVENT_RE = /^[a-z][a-z0-9._-]{0,127}$/\nconst CONTEXT_KEY_RE = /^[a-zA-Z][a-zA-Z0-9._-]{0,63}$/\nconst SECRET_KEY_RE = /(?:api[_-]?key|access[_-]?token|refresh[_-]?token|bearer|authorization|cookie|set[_-]?cookie|nonce|credential|private[_-]?key|password|secret|app[_-]?secret|client[_-]?secret|z_c0|d_c0)$/i\n\nconst CHAT_PAYLOAD_RE =\n  /\"role\"\\s*:\\s*\"(?:system|user|assistant|tool)\"|\"(?:messages|content|prompt|input_text|input_image|image_url)\"\\s*:\\s*[\\[{\"']/i\nconst CREDENTIAL_BODY_RE =\n  /-----BEGIN (?:RSA |EC |OPENSSH |PRIVATE )?PRIVATE KEY-----|\"type\"\\s*:\\s*\"service_account\"|credentials\\.json|\\.dsh[/\\\\](?:credentials|auth)/i\nconst AUTH_HEADER_RE = /\\b(Authorization|Proxy-Authorization|Cookie|Set-Cookie)\\s*:\\s*[^\\r\\n]*/gi\nconst BEARER_RE = /\\bBearer\\s+[A-Za-z0-9._\\-+=/]{8,}/g\nconst SECRET_FIELD_RE =\n  /([\"']?(?:api[_-]?key|access[_-]?token|refresh[_-]?token|token|bearer|authorization|cookie|set-cookie|nonce|credential|private[_-]?key|password|secret|app[_-]?secret|client[_-]?secret|password|z_c0|d_c0)[\"']?\\s*[:=]\\s*)(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|[^\\s,&;}]+)/gi\nconst SECRET_QUERY_RE =\n  /([?&](?:token|api[_-]?key|key|secret|password|bootstrap|code|sig|signature|credential|password)=)[^\\s&#\"']+/gi\nconst URL_CREDENTIAL_RE = /\\b(https?:\\/\\/)[^\\s/:@]+:[^\\s/@]+@/gi\nconst BOOTSTRAP_RE = /\\/bootstrap\\/[^\\s\"'?&#]+/gi\nconst KNOWN_TOKEN_RE = /\\b(?:sk-[A-Za-z0-9_-]{10,}|gh[pousr]_[A-Za-z0-9_]{16,}|github_pat_[A-Za-z0-9_]{20,}|tvly-[A-Za-z0-9_-]{10,}|AKIA[0-9A-Z]{16})\\b/g\nconst PATH_RE = /(?:[A-Za-z]:\\\\|\\\\\\\\)[^\\s\"'`<>|]+|(?:\\/(?:home|Users|tmp|var|root)\\/|~\\/)[^\\s\"'`<>|]+/g\n\nexport function isPluginLogLevel(value: unknown): value is PluginLogLevel {\n  return typeof value === 'string' && (PLUGIN_LOG_LEVELS as readonly string[]).includes(value)\n}\n\nexport function pluginLogLevelEnabled(level: PluginLogLevel, minimum: PluginLogLevel): boolean {\n  return PLUGIN_LOG_LEVELS.indexOf(level) >= PLUGIN_LOG_LEVELS.indexOf(minimum)\n}\n\nexport function normalizePluginLogSource(raw: string): string {\n  const stripped = String(raw || '').trim().replace(/^@[^/]+\\//, '').toLowerCase()\n    .replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '')\n  const prefixed = /^[a-z]/.test(stripped) ? stripped : `p-${stripped}`\n  const bounded = prefixed.slice(0, 64).replace(/-+$/g, '')\n  return SOURCE_RE.test(bounded) ? bounded : 'dsh-plugin'\n}\n\nexport function normalizePluginLogEvent(raw: string): string {\n  const cleaned = String(raw || '').trim().toLowerCase()\n    .replace(/[^a-z0-9._-]+/g, '-').replace(/^[^a-z]+/, '').slice(0, 128)\n  return EVENT_RE.test(cleaned) ? cleaned : 'plugin.event'\n}\n\n/**\n * Parse a level specification like `debug` or `dsh-zhihu=debug,dsh-dot:warn,info`.\n * Source-specific rules win over a bare fallback level.\n */\nexport function parsePluginLogLevel(\n  spec: string | undefined | null,\n  source?: string,\n  fallback: PluginLogLevel = DEFAULT_PLUGIN_LOG_LEVEL,\n): PluginLogLevel {\n  if (!spec || typeof spec !== 'string') return fallback\n  const normalizedSource = source ? normalizePluginLogSource(source) : undefined\n  let wildcard: PluginLogLevel | undefined\n  for (const token of spec.split(',').map(part => part.trim()).filter(Boolean)) {\n    const lowered = token.toLowerCase()\n    if (isPluginLogLevel(lowered)) {\n      wildcard = lowered\n      continue\n    }\n    const match = /^([^=:]+)[=:]([a-z]+)$/i.exec(token)\n    if (!match) continue\n    const target = match[1]!.trim()\n    const candidate = match[2]!.trim().toLowerCase()\n    if (!isPluginLogLevel(candidate)) continue\n    if (target === '*') {\n      wildcard = candidate\n      continue\n    }\n    if (normalizedSource && normalizePluginLogSource(target) === normalizedSource) {\n      return candidate\n    }\n  }\n  return wildcard ?? fallback\n}\n\nexport function sanitizePluginLogText(text: string, maxChars = PLUGIN_LOG_MAX_MESSAGE_CHARS): string {\n  if (!text) return ''\n  if (CREDENTIAL_BODY_RE.test(text)) return '[omitted credential material]'\n  if (CHAT_PAYLOAD_RE.test(text)) return '[omitted chat payload]'\n  const redacted = text\n    .replace(AUTH_HEADER_RE, '$1: [redacted]')\n    .replace(BEARER_RE, 'Bearer [redacted]')\n    .replace(SECRET_FIELD_RE, (full, prefix: string) => {\n      const value = full.slice(prefix.length)\n      if (value.startsWith('\"')) return `${prefix}\"[redacted]\"`\n      if (value.startsWith(\"'\")) return `${prefix}'[redacted]'`\n      return `${prefix}[redacted]`\n    })\n    .replace(SECRET_QUERY_RE, '$1[redacted]')\n    .replace(URL_CREDENTIAL_RE, '$1[redacted]@')\n    .replace(BOOTSTRAP_RE, '/bootstrap/[redacted]')\n    .replace(KNOWN_TOKEN_RE, '[redacted]')\n    .replace(PATH_RE, '[path]')\n  return truncateLogText(redacted, maxChars)\n}\n\nexport function sanitizePluginLogContext(\n  input: PluginLogContext | undefined,\n): Record<string, PluginLogScalar> | undefined {\n  if (!input) return undefined\n  const output: Record<string, PluginLogScalar> = {}\n  for (const [key, value] of Object.entries(input).slice(0, 32)) {\n    if (value === undefined || !CONTEXT_KEY_RE.test(key)) continue\n    if (typeof value === 'number' && !Number.isFinite(value)) continue\n    if (SECRET_KEY_RE.test(key)) {\n      output[key] = '[redacted]'\n      continue\n    }\n    output[key] = typeof value === 'string' ? sanitizePluginLogText(value, 1_000) : value\n  }\n  if (!Object.keys(output).length) return undefined\n  const encoded = JSON.stringify(output)\n  if (encoded.length <= PLUGIN_LOG_MAX_CONTEXT_CHARS) return output\n  return { omitted: true, reason: 'Diagnostic context exceeded its size limit.' }\n}\n\nexport function sanitizePluginLogError(error: unknown): PluginLogError | undefined {\n  if (error === undefined) return undefined\n  const row = error && typeof error === 'object'\n    ? error as { name?: unknown; message?: unknown; stack?: unknown; code?: unknown }\n    : {}\n  const rawMessage = typeof row.message === 'string' ? row.message : String(error)\n  const result: PluginLogError = {\n    name: typeof row.name === 'string' && row.name.trim() ? sanitizePluginLogText(row.name.trim(), 100) : 'Error',\n    message: sanitizePluginLogText(rawMessage) || 'Unknown error',\n  }\n  if (typeof row.stack === 'string' && row.stack.trim()) {\n    result.stack = sanitizePluginLogText(row.stack, 24_000)\n  }\n  if (typeof row.code === 'string' && /^[A-Za-z0-9_./:-]{1,100}$/.test(row.code)) {\n    result.code = sanitizePluginLogText(row.code, 100)\n  } else if (typeof row.code === 'number' && Number.isFinite(row.code)) {\n    result.code = String(row.code)\n  }\n  return result\n}\n\nexport function mergePluginLogContext(\n  base: PluginLogContext | undefined,\n  extra: PluginLogContext | undefined,\n): PluginLogContext | undefined {\n  if (!base) return extra\n  if (!extra) return base\n  return { ...base, ...extra }\n}\n\nexport function buildPluginLogEntry(\n  input: PluginLogInput,\n  meta: {\n    at: Date\n    source: string\n    surface: 'host' | 'client'\n    profile?: string\n    pid?: number\n    correlation?: PluginLogContext\n  },\n): PluginLogEntry {\n  const entry: PluginLogEntry = {\n    version: 1,\n    at: meta.at.toISOString(),\n    level: isPluginLogLevel(input.level) ? input.level : 'info',\n    source: normalizePluginLogSource(meta.source),\n    surface: meta.surface,\n    ...(meta.profile ? { profile: meta.profile } : {}),\n    event: normalizePluginLogEvent(input.event),\n    message: sanitizePluginLogText(input.message || 'No diagnostic message was provided.', PLUGIN_LOG_MAX_MESSAGE_CHARS),\n    ...(meta.pid !== undefined ? { pid: meta.pid } : {}),\n  }\n  const context = sanitizePluginLogContext(mergePluginLogContext(meta.correlation, input.context))\n  if (context) entry.context = context\n  const error = sanitizePluginLogError(input.error)\n  if (error) entry.error = error\n  return entry\n}\n\nexport function createChildPluginLogger(parent: PluginLogger, bound: PluginLogContext): PluginLogger {\n  return {\n    get source() { return parent.source },\n    get file() { return parent.file },\n    get lastWriteError() { return parent.lastWriteError },\n    debug: (event, message, context) => parent.debug(event, message, mergePluginLogContext(bound, context)),\n    info: (event, message, context) => parent.info(event, message, mergePluginLogContext(bound, context)),\n    warn: (event, message, error, context) => parent.warn(event, message, error, mergePluginLogContext(bound, context)),\n    error: (event, message, error, context) => parent.error(event, message, error, mergePluginLogContext(bound, context)),\n    fault: (event, message, error, context) => parent.fault(event, message, error, mergePluginLogContext(bound, context)),\n    write: input => parent.write({ ...input, context: mergePluginLogContext(bound, input.context) }),\n    child: next => createChildPluginLogger(parent, mergePluginLogContext(bound, next) ?? {}),\n  }\n}\n\nexport function truncateLogText(text: string, maxChars: number): string {\n  if (text.length <= maxChars) return text\n  const marker = '[truncated]\\n'\n  if (maxChars <= marker.length) return text.slice(0, Math.max(0, maxChars))\n  return `${marker}${text.slice(-(maxChars - marker.length))}`\n}\n","import {\n  DEFAULT_PLUGIN_LOG_LEVEL, buildPluginLogEntry, createChildPluginLogger,\n  normalizePluginLogSource, parsePluginLogLevel, pluginLogLevelEnabled,\n  sanitizePluginLogText,\n  type PluginLogContext, type PluginLogEntry, type PluginLogInput,\n  type PluginLogLevel, type PluginLogger,\n} from './log-shared.ts'\n\nexport * from './log-shared.ts'\n\nexport const CLIENT_PLUGIN_LOG_GLOBAL = '__KLARKXY_PLUGIN_LOGS__'\nexport const CLIENT_PLUGIN_LOG_LIMIT = 500\n\nexport interface ClientPluginLoggerOptions {\n  minimumLevel?: PluginLogLevel\n  now?: () => Date\n  bufferLimit?: number\n  forwardToHostLogger?: boolean\n  loadedContext?: PluginLogContext\n}\n\ntype BrowserContextLike = {\n  effect?: (callback: () => () => void, label?: string) => unknown\n  logger?: