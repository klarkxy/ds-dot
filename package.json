{
  "name": "ds-dot",
  "version": "0.3.0",
  "description": "Dorothy (dot): an always-on coordinator for DeepSeek Harness. Talk to Dorothy in her dedicated panel to manage workspaces, dispatch and verify tasks across sessions, handle routine approvals and questions, and get concise reports.",
  "icon": "./icon.svg",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "import": "./lib/tools.js",
      "default": "./lib/tools.js"
    },
    "./reflection": {
      "types": "./lib/reflection.d.ts",
      "import": "./lib/reflection.js",
      "default": "./lib/reflection.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib",
    "src",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh-CN.md",
    "docs/README.ja.md",
    "docs/images/dot-arrival.png",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "client": {
        "inject": [
          "@deepseek-ai/dsh-client-connection",
          "@deepseek-ai/dsh-api-remotes",
          "@deepseek-ai/dsh-client-ui-slots",
          "@deepseek-ai/dsh-client-ui-sidebar",
          "@deepseek-ai/dsh-client-ui-workspace",
          "@deepseek-ai/dsh-client-ui-primitives",
          "@deepseek-ai/dsh-client-locale"
        ]
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test .agents/skills/dsh-web-acceptance/scripts/dsh-qa-harness.test.js && vitest run",
    "prepare": "tsdown"
  },
  "dependencies": {
    "@klarkxy/dsh-deep-view": "^0.3.4",
    "@klarkxy/dsh-plugin-kit": "^0.8.1",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/schemastery": ">=3.18.4",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-user-approval": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-user-questions": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-web": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-web": ">=0.2.2-rc.5",
    "@klarkxy/dsh-dev-index": ">=0.3.2",
    "@klarkxy/dsh-model-picker": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-scope": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-web": {
      "optional": true
    },
    "@klarkxy/dsh-dev-index": {
      "optional": true
    },
    "@klarkxy/dsh-model-picker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.1",
    "jsdom": "29.1.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.3.0",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.5",
    "@deepseek-ai/dsh-web": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-web": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-todo": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@klarkxy/dsh-plugin-kit": "^0.8.1"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "coordinator",
    "agent-orchestration",
    "session-manager",
    "task-board"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klarkxy/ds-dot.git"
  },
  "homepage": "https://github.com/klarkxy/ds-dot",
  "bugs": {
    "url": "https://github.com/klarkxy/ds-dot/issues"
  }
}
